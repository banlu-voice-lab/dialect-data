        "seg_cer": 0.062,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "浓浓的果香也是扑鼻而来。那么果冻呢？"
      }
    },
    {
      "id": 5,
      "start": 13.978,
      "end": 16.7,
      "label": "guilin",
      "text": "也就迎来了这一年当中最甜蜜的时光。",
