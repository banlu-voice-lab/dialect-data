        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "甚至啊，蛮多人因为这个“初书”就是“初父”的意思。"
      }
    },
    {
      "id": 5,
      "start": 13.846,
      "end": 19.049,
      "label": "guilin",
      "text": "高温里处暑养生，我们要记住以下这几条。",
      "score": 0.0807,
