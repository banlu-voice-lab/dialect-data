        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "月令七十二后七改。"
      }
    },
    {
      "id": 11,
      "start": 39.461,
      "end": 43.458,
      "label": "mandarin",
      "text": "处去也，暑气自此止矣。",
      "score": 0.7425,
