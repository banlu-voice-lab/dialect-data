    {
      "id": 22,
      "start": 84.607,
      "end": 90.642,
      "label": "guilin",
      "text": "有利于缓解秋乏。睡觉应该关注腹部盖薄被，防止受凉。",
      "score": 0.1455,
      "wav": "",
      "signals": {
        "mand_logprob": -0.019,
        "sc_logprob": -0.0176,
        "sc_delta": 0.0014,
        "acoustic_dev": 0.0,
        "seg_cer": 0.318,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "有利于反盖囚法。睡觉应该关注腹部、背部，防止受凉。"
      }
    },
    {
      "id": 23,
      "start": 91.015,
      "end": 93.894,
      "label": "guilin",
      "text": "初秋此时，初夜未消，",
      "score": 0.5694,
