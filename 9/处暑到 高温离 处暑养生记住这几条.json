        "seg_cer": 0.045,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "“重于白露”的讲法，意思就是一年当中时期最重的时间。"
      }
    },
    {
      "id": 18,
      "start": 68.749,
      "end": 72.407,
      "label": "guilin",
      "text": "从大处开始到白露就结束了。",
