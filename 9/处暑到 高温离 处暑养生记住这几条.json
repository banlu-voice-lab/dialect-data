      }
    },
    {
      "id": 16,
      "start": 59.611,
      "end": 63.23,
      "label": "guilin",
      "text": "另外有“时土之令始于大处，",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -2.8869,
        "sc_logprob": -2.803,
