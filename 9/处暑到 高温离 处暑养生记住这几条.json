        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我们经常呢，就会把它和储户诶联系在一起。"
      }
    },
    {
      "id": 4,
      "start": 10.008,
      "end": 13.809,
      "label": "guilin",
      "text": "甚至蛮多人因为这个处暑就是处暑的意思，",
      "score": 0.3455,
      "wav": "",
      "signals": {
        "mand_logprob": -0.5179,
