        "seg_cer": 0.778,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "楚书即《楚书简》与《秋仪》。"
      }
    },
    {
      "id": 13,
      "start": 47.16,
      "end": 50.099,
      "label": "guilin",
      "text": "请你跟上时间的步伐，调养身体。",
