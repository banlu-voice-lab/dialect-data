        "seg_cer": 0.188,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "通过水雾胶可以弥补夜晚的睡眠不足。"
      }
