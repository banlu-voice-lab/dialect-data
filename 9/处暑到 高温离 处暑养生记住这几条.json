    {
      "id": 21,
      "start": 80.523,
      "end": 84.449,
      "label": "guilin",
      "text": "通过睡午觉可以弥补夜晚的睡眠不足，",
      "score": 0.0857,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0367,
        "sc_logprob": -0.0501,
