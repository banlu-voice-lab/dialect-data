    {
      "id": 3,
      "start": 5.615,
      "end": 9.78,
      "label": "guilin",
      "text": "我们经常呢就会把它和处暑哎联系在一起，",
      "score": 0.1136,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1865,
        "sc_logprob": -0.1782,
