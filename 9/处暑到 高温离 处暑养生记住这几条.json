        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "自/之 暑/苏",
        "lexicon": "",
        "text_free": "除渠也，苏淇之词之一。"
      }
    },
    {
      "id": 12,
      "start": 43.54,
      "end": 47.005,
      "label": "guilin",
      "text": "处暑即处暑，渐入秋意，",
      "score": 0.1687,
      "wav": "",
