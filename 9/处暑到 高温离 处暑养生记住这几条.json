        "seg_cer": 0.176,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "高温力，图书养生。我们要记住以下这几条。"
      }
    },
    {
      "id": 6,
      "start": 19.68,
      "end": 22.082,
      "label": "guilin",
      "text": "处暑过后，夜朗渐渐褪",
      "score": 0.6692,
      "wav": "",
      "signals": {
        "mand_logprob": -1.0498,
        "sc_logprob": -1.0733,
        "sc_delta": -0.0236,
        "acoustic_dev": 0.979,
        "seg_cer": 0.778,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "楚叔国侯野狼渐渐退。"
      }
    },
    {
      "id": 7,
      "start": 22.345,
      "end": 25.757,
      "label": "guilin",
      "text": "去，清风徐来，秋天便有了秋的味道。",
      "score": 0.0461,
      "wav": "",
      "signals": {
