        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "也会增加胃病、骨质疏松。"
      }
    },
    {
      "id": 9,
      "start": 36.358,
      "end": 40.46,
      "label": "guilin",
      "text": "肥胖等等疾病的风险。预防控制高血压，",
