        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "肌肉当中富含大量的蛋白质，非常适合人体的消化。"
      }
    },
    {
      "id": 12,
      "start": 50.599,
      "end": 53.191,
      "label": "guilin",
      "text": "中伏时候呢，人体的消耗增大，",
      "score": 0.68,
      "wav": "",
