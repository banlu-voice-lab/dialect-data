        "sc_logprob": -0.0023,
        "sc_delta": -0.0004,
        "acoustic_dev": 0.0,
        "seg_cer": 0.13,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "适当的吃一些肌肉类的蛋白质食物，有助于补充体力。"
      }
    },
    {
      "id": 14,
      "start": 57.569,
      "end": 60.965,
      "label": "guilin",
      "text": "经过这段，那啊例子。猪脚，",
