        "sc_logprob": -1.1796,
        "sc_delta": 0.1739,
        "acoustic_dev": 1.0,
        "seg_cer": 0.5,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "总负荷呢，因体力消耗增大。"
      }
    },
    {
      "id": 13,
      "start": 53.191,
      "end": 57.569,
      "label": "guilin",
      "text": "适当的吃一些鸡肉里面的蛋白质食物，有助于补充体力。",
      "score": 0.0596,
      "wav": "",
