        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "好多年了，经过品种不断的改良。"
      }
    },
    {
      "id": 7,
      "start": 25.025,
      "end": 28.927,
      "label": "guilin",
      "text": "现在啊培育出了鸡心黄皮果、无籽黄皮果、",
