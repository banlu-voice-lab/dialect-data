        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一筐筐放苹果呢，也达到丰收的喜悦。"
      }
    },
    {
      "id": 5,
      "start": 16.948,
      "end": 22.386,
      "label": "guilin",
      "text": "准备销往全国各地。杨树县普义乡刘公村种的黄皮果呢，",
      "score": 0.6638,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4316,
        "sc_logprob": -0.4001,
        "sc_delta": 0.0315,
        "acoustic_dev": 0.969,
        "seg_cer": 0.522,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "准备销往全国各地。阳朔县铺一项六工程中的防壁锅呢。"
      }
    },
    {
      "id": 6,
      "start": 22.386,
      "end": 25.025,
      "label": "mandarin",
      "text": "有好多年了。经过品种不断的改良，",
      "score": 0.0784,
      "wav": "",
