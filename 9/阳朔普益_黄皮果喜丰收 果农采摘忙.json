        "phon_confuse": 0.125,
        "phon_examples": "心/兴",
        "lexicon": "",
        "text_free": "现在培育出了即兴放屁锅，无籽放屁锅。"
      }
    },
    {
      "id": 8,
      "start": 28.927,
      "end": 33.495,
      "label": "guilin",
      "text": "甜黄皮果等品种。果农廖志刚种的黄皮果呢有十八年了，",
