        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "避免坠物砸伤。五"
      }
    },
    {
      "id": 11,
      "start": 37.419,
      "end": 41.3,
      "label": "guilin",
      "text": "如果遇到强降雨，尽量不要坐地向交通工具。",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0021,
        "sc_logprob": -0.002,
        "sc_delta": 0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.056,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "如果遇到强降雨，尽量不要坐地下交通工具。"
      }
    },
    {
      "id": 12,
      "start": 41.728,
      "end": 45.15,
      "label": "guilin",
      "text": "雨天行车要减速慢行，防止车辆进水。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0079,
        "sc_logprob": -0.008,
        "sc_delta": -0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "雨天行车要减速慢行，防止车辆进水。"
      }
    },
    {
      "id": 13,
      "start": 45.383,
      "end": 48.651,
      "label": "guilin",
      "text": "尽量避免驶入积水区或地势低洼区。",
      "score": 0.102,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0141,
        "sc_logprob": -0.0142,
        "sc_delta": -0.0001,
