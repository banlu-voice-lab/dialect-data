        "seg_cer": 0.2,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "尽量避免使用集水区或地势低洼区。"
      }
    },
    {
      "id": 14,
      "start": 48.979,
      "end": 55.373,
      "label": "guilin",
      "text": "一、如果车辆周围已经形成积水，应该马上离开车辆到地势较高的地方。",
      "score": 0.0,
      "wav": "",
      "signals": {
