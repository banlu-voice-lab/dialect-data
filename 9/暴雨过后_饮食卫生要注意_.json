        "mand_logprob": -0.0149,
        "sc_logprob": -0.018,
        "sc_delta": -0.0031,
        "acoustic_dev": 0.0,
        "seg_cer": 0.069,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "食/私",
        "lexicon": "",
        "text_free": "每当强降雨、特大暴雨过后，人们的这个隐私、卫生和安全应该如何保障？"
      }
    },
    {
      "id": 2,
      "start": 7.468,
      "end": 14.14,
      "label": "guilin",
      "text": "我们需要注意点什么嘞？小编帮我们总结了一些小知识，现在就分享给大家。",
      "score": 0.1137,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0455,
        "sc_logprob": -0.0567,
        "sc_delta": -0.0112,
        "acoustic_dev": 0.0,
        "seg_cer": 0.161,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "我们需要注意点什么呢？小面包总结了一些小知识，现在就分享给大家。"
      }
    },
    {
      "id": 3,
      "start": 14.359,
      "end": 16.872,
      "label": "guilin",
      "text": "食品卫生需警惕：一、",
      "score": 0.5771,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6236,
        "sc_logprob": -0.5097,
        "sc_delta": 0.114,
        "acoustic_dev": 1.0,
        "seg_cer": 0.125,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "食品卫生需警惕。"
      }
    },
    {
      "id": 4,
      "start": 16.872,
      "end": 21.241,
      "label": "guilin",
      "text": "忌吃水淹食品，不食用在暴雨中浸泡过的食物，",
      "score": 0.0722,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0361,
        "sc_logprob": -0.0369,
        "sc_delta": -0.0008,
        "acoustic_dev": 0.0,
        "seg_cer": 0.158,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "机制水淹食品，不适用在暴雨中浸泡过的食物。"
      }
    },
    {
      "id": 5,
      "start": 21.241,
      "end": 24.181,
      "label": "guilin",
      "text": "不吃淹死、病死的禽畜、水产品。",
      "score": 0.3199,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1251,
        "sc_logprob": -0.1441,
        "sc_delta": -0.019,
        "acoustic_dev": 0.147,
        "seg_cer": 0.5,
        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "畜/醋 禽/清",
        "lexicon": "",
        "text_free": "不吃盐水、冰水的清醋水产品。"
      }
    },
    {
      "id": 6,
      "start": 24.483,
      "end": 27.121,
      "label": "guilin",
      "text": "注意，如果冰箱遭遇水侵入，",
      "score": 0.2011,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2546,
        "sc_logprob": -0.2399,
        "sc_delta": 0.0147,
        "acoustic_dev": 0.387,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "注意：如果冰箱遭遇水侵入。"
      }
    },
    {
      "id": 7,
      "start": 27.121,
      "end": 31.386,
      "label": "guilin",
      "text": "或者是曾经停电，冰箱留的食物最好丢了可不要吃。",
