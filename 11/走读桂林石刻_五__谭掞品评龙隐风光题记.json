        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在游龙一岸所留刻。"
      }
    },
    {
      "id": 7,
      "start": 36.889,
      "end": 39.624,
      "label": "mandarin",
      "text": "呃，这件石刻其实可以从两个角度来这个理解。",
