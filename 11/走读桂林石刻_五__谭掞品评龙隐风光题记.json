        "seg_cer": 0.1,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "也就是公元一亿零一年。"
      }
    },
    {
      "id": 4,
      "start": 23.591,
      "end": 28.045,
      "label": "mandarin",
      "text": "书体为楷书，整件石刻高八十八公分，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0305,
        "sc_logprob": -0.0321,
        "sc_delta": -0.0016,
