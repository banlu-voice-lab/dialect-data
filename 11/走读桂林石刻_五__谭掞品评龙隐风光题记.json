        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "书体为楷书，整件石刻高八十八公分。"
      }
    },
    {
      "id": 5,
      "start": 28.045,
      "end": 32.767,
      "label": "mandarin",
      "text": "宽七十七公分，是潭山荔枝飞向前，",
      "score": 0.5077,
