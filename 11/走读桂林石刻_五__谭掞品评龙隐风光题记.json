        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "潭/唐",
        "lexicon": "",
        "text_free": "宽七十七公分，是唐山荔枝飞翔前。"
      }
    },
    {
      "id": 6,
      "start": 32.767,
      "end": 35.25,
      "label": "mandarin",
      "text": "在游龙隐岸所留刻。",
