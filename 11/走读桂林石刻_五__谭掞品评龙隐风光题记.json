        "lang_free": "Chinese",
        "phon_confuse": 0.1,
        "phon_examples": "潭/唐",
        "lexicon": "",
        "text_free": "唐山的这件铁机，可与白松肩中经过元年。"
      }
    },
    {
      "id": 3,
      "start": 20.732,
      "end": 23.253,
      "label": "mandarin",
      "text": "也就是公元一一零一年。",
      "score": 0.0457,
      "wav": "",
      "signals": {
