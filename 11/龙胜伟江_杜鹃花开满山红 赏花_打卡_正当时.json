        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在尾江乡干家村，每年的四月到六月是野生杜鹃花盛开的时节。"
      }
    },
    {
