        "phon_confuse": 0.154,
        "phon_examples": "啷/让 啷/让",
        "lexicon": "",
        "text_free": "就是让这个放在文字，哎，顶以后，让这把它小中之养。"
      }
    },
    {
      "id": 3,
      "start": 8.436,
      "end": 11.464,
      "label": "mandarin",
      "text": "今天呢，我们也收集了一些科学的防蚊攻略，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.003,
