        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今天呢，我们也收集了一些科学的防蚊攻略。"
      }
    },
    {
      "id": 4,
      "start": 11.464,
      "end": 14.905,
      "label": "mandarin",
      "text": "和大家一起分享一下。物理驱蚊的方法，",
      "score": 0.2289,
      "wav": "",
      "signals": {
        "mand_logprob": -0.5456,
        "sc_logprob": -0.5433,
        "sc_delta": 0.0023,
