        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "去看一下子。头茶是新春的第一出茶。"
      }
    },
    {
      "id": 4,
      "start": 11.688,
      "end": 16.37,
      "label": "mandarin",
      "text": "春季气温适中，是叶量当中采摘头茶的最好时节。",
      "score": 0.1519,
