        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "此时的茶书储蓄了一个冬天的能量。"
      }
    },
    {
      "id": 6,
      "start": 20.31,
      "end": 23.42,
      "label": "mandarin",
      "text": "包蕴天地精华，色泽翠绿，",
      "score": 0.7116,
