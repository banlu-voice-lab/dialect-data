    {
      "id": 3,
      "start": 7.641,
      "end": 11.542,
      "label": "mandarin",
      "text": "看一下子。头茶是新春的第一处茶，",
      "score": 0.4048,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6131,
