        "phon_examples": "",
        "lexicon": "",
        "text_free": "加上体育锻炼，才能达到最佳的感重效果。"
      }
    },
    {
      "id": 15,
      "start": 56.366,
      "end": 60.58,
      "label": "mandarin",
      "text": "那么这些小小的习惯，给你不知不觉的就变瘦了。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0021,
        "sc_logprob": -0.0023,
        "sc_delta": -0.0002,
