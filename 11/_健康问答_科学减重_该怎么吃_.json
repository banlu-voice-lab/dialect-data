        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么，这些小小的习惯，给你不知不觉的就变瘦了。"
      }
    },
    {
      "id": 16,
      "start": 60.912,
      "end": 63.74,
      "label": "mandarin",
      "text": "改变吃饭的顺序，先吃油，",
