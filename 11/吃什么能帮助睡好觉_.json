        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "夜晚睡得短，但是白天不容易困。"
      }
    },
    {
      "id": 12,
      "start": 46.792,
      "end": 50.185,
      "label": "mandarin",
      "text": "所以早晨和中午可以多摄入蛋白质，",
