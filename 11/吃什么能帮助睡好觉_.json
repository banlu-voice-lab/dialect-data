        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "醒/新",
        "lexicon": "",
        "text_free": "第二，摄入较多的蛋白质，会让人更加清新。"
      }
    },
    {
      "id": 11,
      "start": 42.98,
      "end": 46.598,
      "label": "mandarin",
      "text": "夜晚睡得短，但是白天不容易困，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0001,
