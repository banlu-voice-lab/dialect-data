        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "三，下水前呢，活动身体，避免出现抽筋的现象。"
      }
    },
    {
      "id": 18,
      "start": 68.472,
      "end": 71.725,
      "label": "mandarin",
      "text": "四，在水里啊千万莫吃东西；",
      "score": 0.0202,
