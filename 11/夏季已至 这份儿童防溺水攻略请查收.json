        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "第一个，千万莫私自可用。"
      }
    },
    {
      "id": 15,
      "start": 57.477,
      "end": 60.22,
      "label": "mandarin",
      "text": "必须在家长的看护下才下水；",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.002,
        "sc_logprob": -0.0032,
        "sc_delta": -0.0012,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "必须在家长的看护下才下水。"
      }
    },
