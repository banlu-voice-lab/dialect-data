    {
      "id": 17,
      "start": 63.259,
      "end": 68.23,
      "label": "mandarin",
      "text": "三，下水前呢活动身体，避免出现抽筋的现象；",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0128,
