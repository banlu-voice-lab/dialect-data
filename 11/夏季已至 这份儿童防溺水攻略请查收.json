        "phon_examples": "",
        "lexicon": "",
        "text_free": "比如讲，像池塘、湖泊、江河等等。"
      }
    },
    {
      "id": 13,
      "start": 51.985,
      "end": 54.557,
      "label": "guilin",
      "text": "防溺水要牢记七个要点：",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -2.3795,
        "sc_logprob": -2.2675,
