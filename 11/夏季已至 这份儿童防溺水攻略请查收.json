        "phon_examples": "",
        "lexicon": "",
        "text_free": "五到九岁儿童溺水高发地点呢，会涉及到水渠。"
      }
    },
    {
      "id": 11,
      "start": 43.139,
      "end": 48.537,
      "label": "mandarin",
      "text": "池塘、水库这地方。四岁以上的孩子活动范围呢就更大了，",
      "score": 0.4078,
