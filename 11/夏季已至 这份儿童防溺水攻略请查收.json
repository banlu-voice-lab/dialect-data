        "lang_free": "Cantonese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "譬如讲水缸、鱼盆。"
      }
    },
    {
      "id": 10,
      "start": 38.779,
      "end": 43.139,
      "label": "mandarin",
      "text": "五到九岁儿童溺水高发地点呢会涉及到水渠、",
      "score": 0.0,
