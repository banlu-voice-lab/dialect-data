        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "池塘、水库这地方，十水上的八达山活动范围呢，就更大了。"
      }
    },
    {
      "id": 12,
      "start": 48.537,
      "end": 51.582,
