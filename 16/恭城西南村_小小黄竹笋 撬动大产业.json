        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一大早，当地村民就被一起住楼。"
      }
    },
    {
      "id": 8,
      "start": 25.452,
      "end": 27.906,
      "label": "mandarin",
      "text": "在竹林间忙活起来了。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0008,
        "sc_logprob": -0.0009,
        "sc_delta": -0.0002,
