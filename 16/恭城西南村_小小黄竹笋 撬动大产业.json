        "acoustic_dev": 0.0,
        "seg_cer": 0.1,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "可以看到，家家户户门前的院子都晾晒到防尘干。"
      }
    },
    {
      "id": 6,
      "start": 19.195,
      "end": 22.531,
      "label": "mandarin",
      "text": "空气当中弥漫着一股笋干的香味。",
