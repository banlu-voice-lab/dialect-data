        "seg_cer": 0.143,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "空气当中弥漫着一股深感的香味。"
      }
    },
    {
      "id": 7,
      "start": 22.784,
      "end": 25.305,
      "label": "guilin",
      "text": "一大早，当地村民就背起竹篓，",
