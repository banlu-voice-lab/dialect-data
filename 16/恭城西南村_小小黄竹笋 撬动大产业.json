        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "有那六亩竹笋，每年这个时候都上会上山。"
      }
    },
    {
      "id": 10,
      "start": 33.4,
      "end": 35.56,
      "label": "mandarin",
      "text": "我今年的竹笋的产量大，",
      "score": 0.0,
      "wav": "",
