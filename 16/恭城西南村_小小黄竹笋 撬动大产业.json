        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "竹/租",
        "lexicon": "",
        "text_free": "现在的可多是房租生啊，收获的季节。"
      }
    },
    {
      "id": 2,
      "start": 3.613,
      "end": 7.38,
      "label": "guilin",
      "text": "在工程瑶族自治县加肥镇西南村，",
      "score": 0.4897,
      "wav": "",
      "signals": {
        "mand_logprob": -0.7154,
