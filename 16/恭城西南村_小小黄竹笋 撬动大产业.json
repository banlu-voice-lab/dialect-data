        "seg_cer": 0.429,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在工程要做之前，加菲镇西南村。"
      }
    },
    {
      "id": 3,
      "start": 7.514,
      "end": 10.68,
      "label": "guilin",
      "text": "村民呢就趁着晴好的天气挖竹笋、",
      "score": 0.4324,
      "wav": "",
      "signals": {
        "mand_logprob": -0.8152,
        "sc_logprob": -0.6848,
        "sc_delta": 0.1304,
        "acoustic_dev": 0.769,
        "seg_cer": 0.071,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "村民呢，就趁着晴好的天气挖竹。"
      }
    },
    {
      "id": 4,
      "start": 11.059,
      "end": 14.533,
      "label": "mandarin",
      "text": "晒竹干。走进加肥镇西南村，",
      "score": 0.4058,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6463,
        "sc_logprob": -0.7471,
        "sc_delta": -0.1009,
        "acoustic_dev": 0.541,
        "seg_cer": 0.273,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "晒竹竿。走进贾飞镇西南村。"
      }
    },
    {
      "id": 5,
      "start": 14.533,
      "end": 18.992,
      "label": "guilin",
      "text": "可以看到家家户户门前的院子都晾晒到房笋干，",
