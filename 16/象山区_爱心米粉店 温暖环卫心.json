      "signals": {
        "mand_logprob": -0.3967,
        "sc_logprob": -0.3866,
        "sc_delta": 0.01,
        "acoustic_dev": 0.239,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "不管是太阳暴晒，还是刮风下雨。"
      }
    },
    {
      "id": 25,
      "start": 87.036,
      "end": 91.309,
      "label": "mandarin",
      "text": "环卫工人啊都是早出晚归，为城市的使用环境在忙叨，",
      "score": 0.0208,
      "wav": "",
      "signals": {
        "mand_logprob": -0.099,
        "sc_logprob": -0.1718,
        "sc_delta": -0.0728,
        "acoustic_dev": 0.0,
        "seg_cer": 0.045,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "环卫工人嘛，都是早出晚归，为城市的使用环境在忙叨。"
      }
    },
    {
      "id": 26,
      "start": 91.309,
      "end": 95.947,
      "label": "guilin",
      "text": "也特别辛苦。所以这一切，陈建国、陈建军兄妹呢都看在眼里面。",
      "score": 0.0549,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0513,
        "sc_logprob": -0.051,
        "sc_delta": 0.0003,
        "acoustic_dev": 0.0,
        "seg_cer": 0.12,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "也特别辛苦，所以这一切，陈坚国、陈坚军兄妹呢，都看到眼里面。"
      }
    },
    {
      "id": 27,
      "start": 96.361,
      "end": 100.385,
      "label": "guilin",
      "text": "考虑到环卫工人普遍年纪都偏大了，收入呢又不是很高，",
      "score": 0.0795,
      "wav": "",
      "signals": {
