      }
    },
    {
      "id": 31,
      "start": 110.114,
      "end": 114.158,
      "label": "guilin",
      "text": "反正也是成本卖给他们就行了，是不是？",
      "score": 0.0286,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0326,
        "sc_logprob": -0.0312,
        "sc_delta": 0.0014,
        "acoustic_dev": 0.0,
