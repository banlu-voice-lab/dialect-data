        "sc_logprob": -0.0139,
        "sc_delta": 0.0006,
        "acoustic_dev": 0.0,
        "seg_cer": 0.133,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
