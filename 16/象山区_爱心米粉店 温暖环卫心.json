        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "反正也是成本卖给他们就行了，是不是啊？"
      }
    },
    {
      "id": 32,
      "start": 114.158,
      "end": 121.817,
