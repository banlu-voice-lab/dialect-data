        "sc_logprob": -0.022,
        "sc_delta": 0.0011,
        "acoustic_dev": 0.0,
        "seg_cer": 0.174,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "考虑到范围供应普遍年纪都偏大了，收入呢又不是很高。"
