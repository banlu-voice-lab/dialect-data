        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "子/至",
        "lexicon": "",
        "text_free": "甚至呢，又可以省时间，煮出来的银耳啊，会更加的浓。"
      }
    },
    {
      "id": 14,
      "start": 48.95,
      "end": 51.721,
      "label": "guilin",
      "text": "红枣银耳羹，滋阴润肺，",
