        "sc_delta": 0.0022,
        "acoustic_dev": 0.048,
        "seg_cer": 0.062,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "选过大、肉厚、核小的干枣，洗干净之后呢。"
