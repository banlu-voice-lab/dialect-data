      }
    },
    {
      "id": 4,
      "start": 10.116,
      "end": 16.403,
      "label": "guilin",
      "text": "熬一碗银耳羹，不仅滋阴润燥，还可以让你的身体暖暖和和的。",
      "score": 0.0,
      "wav": "",
