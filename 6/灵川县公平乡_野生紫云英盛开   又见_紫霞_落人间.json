      }
    },
    {
      "id": 7,
      "start": 23.56,
      "end": 29.259,
      "label": "guilin",
      "text": "落霞晨光。阳春三月，又到了紫云英的最佳观赏期，",
      "score": 0.3339,
      "wav": "",
