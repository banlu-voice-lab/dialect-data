        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "民/名",
        "lexicon": "",
        "text_free": "今天我是受到成名王大姐的邀请。"
      }
    },
    {
      "id": 13,
      "start": 60.477,
      "end": 65.071,
      "label": "guilin",
      "text": "来到她屋里头和亲戚朋友一起动手制作糍粑。",
      "score": 0.0641,
      "wav": "",
      "signals": {
