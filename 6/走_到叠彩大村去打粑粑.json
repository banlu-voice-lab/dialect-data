      "end": 5.537,
      "label": "guilin",
      "text": "收到，版罗看快乐，长相伴，大家龙年大吉，幸福安康。",
      "score": 0.1667,
      "wav": "",
      "signals": {
        "mand_logprob": -0.5453,
        "sc_logprob": -0.5536,
        "sc_delta": -0.0083,
        "acoustic_dev": 0.145,
        "seg_cer": 0.2,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "手到半路看，快乐常相伴。大家龙年大吉，幸福安康。"
      }
    },
    {
      "id": 2,
      "start": 5.537,
      "end": 9.885,
      "label": "guilin",
      "text": "今天大年初四，好吃老关心的还是好吃的。",
      "score": 0.0269,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0068,
        "sc_logprob": -0.0068,
        "sc_delta": -0.0,
