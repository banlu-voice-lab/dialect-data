        "seg_cer": 0.462,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "小包爷，小包爷，小包爷啊。"
      }
    },
    {
      "id": 37,
