        "seg_cer": 0.35,
        "lang_free": "Chinese",
        "phon_confuse": 0.167,
        "phon_examples": "经/进",
        "lexicon": "",
        "text_free": "进来炒，炒他不是讲，我炒他想要什么都给他嘛。"
      }
    },
    {
      "id": 41,
      "start": 181.088,
      "end": 184.877,
      "label": "guilin",
      "text": "陈某那心里头好有数的，给他嘛给，",
