        "sc_delta": 0.0086,
        "acoustic_dev": 0.143,
        "seg_cer": 0.625,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "不歇下，再开，又从那个地方慢慢走下来。"
      }
    },
    {
      "id": 74,
      "start": 315.63,
      "end": 319.95,
      "label": "guilin",
      "text": "哦，那合理哦。这个台子蛮特别，",
