        "sc_delta": 0.2144,
        "acoustic_dev": 1.0,
        "seg_cer": 0.8,
        "lang_free": "Chinese",
        "phon_confuse": 0.091,
        "phon_examples": "了/呢",
        "lexicon": "",
        "text_free": "是不是都能理解一下？如果从哪里走过来的时候，走到这个呢？"
      }
    },
    {
      "id": 72,
      "start": 310.197,
      "end": 312.791,
      "label": "mandarin",
      "text": "进去了，下马，下马高，",
