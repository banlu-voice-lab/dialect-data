        "acoustic_dev": 1.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "青春呢，就这个下巴那么高。"
      }
    },
    {
      "id": 73,
      "start": 312.791,
      "end": 315.63,
      "label": "guilin",
      "text": "先下这个，又从那边慢慢走下来，走一下。",
      "score": 0.2342,
