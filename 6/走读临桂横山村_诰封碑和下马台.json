        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我们见到了一个好大的台子。"
      }
    },
    {
      "id": 66,
      "start": 282.494,
      "end": 285.474,
      "label": "guilin",
      "text": "村民们都喊他下马台。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1013,
        "sc_logprob": -0.102,
        "sc_delta": -0.0007,
