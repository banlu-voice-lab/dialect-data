        "seg_cer": 0.667,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "他紧在旁边抄，他一直在抄。"
      }
    },
    {
      "id": 38,
      "start": 170.158,
      "end": 172.752,
      "label": "guilin",
      "text": "我要要，我要要什么东西？",
