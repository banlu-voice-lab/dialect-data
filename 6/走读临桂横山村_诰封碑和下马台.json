        "seg_cer": 0.333,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "哦，那会你又让。这个台子蛮特别。"
      }
    },
    {
