        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "村民们都喊他“下马台”。"
      }
    },
    {
      "id": 67,
      "start": 287.219,
      "end": 291.79,
      "label": "guilin",
      "text": "这个这个是什么台子？下马台，八八国形状的，八国的啊。",
      "score": 0.0831,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0369,
        "sc_logprob": -0.0363,
        "sc_delta": 0.0005,
        "acoustic_dev": 0.0,
        "seg_cer": 0.182,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这个这个是个什么台子？虾马台，八八国行章的八国的啊。"
      }
    },
    {
      "id": 68,
      "start": 292.067,
      "end": 297.87,
      "label": "guilin",
      "text": "这前面好了，放点那那五光，他要骑马过来，到这下马的。",
