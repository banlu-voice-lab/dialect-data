        "seg_cer": 0.357,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "乔木，他心里头好有数的。给一袋嘛，给。"
      }
    },
    {
      "id": 42,
      "start": 184.886,
      "end": 190.705,
      "label": "guilin",
      "text": "你讲了给，那都马上那其他的人就都一跪跪下个谢祖宗了。",
