        "sc_delta": 0.0724,
        "acoustic_dev": 0.982,
        "seg_cer": 0.909,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "有个工程员，呐很差劲的。"
      }
    },
    {
      "id": 33,
      "start": 145.48,
      "end": 148.648,
      "label": "guilin",
      "text": "嗯，这这讲茶江神木西祠场，",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -2.1701,
        "sc_logprob": -2.1317,
        "sc_delta": 0.0383,
        "acoustic_dev": 1.0,
        "seg_cer": 0.636,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "嗯，就讲长江，什么洗车场。"
      }
    },
    {
      "id": 34,
      "start": 148.648,
      "end": 153.64,
      "label": "guilin",
      "text": "这这根据几户对联呢？再讲讲湖南什么江永那个，",
      "score": 0.2,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6029,
        "sc_logprob": -0.6863,
        "sc_delta": -0.0834,
        "acoustic_dev": 0.0,
        "seg_cer": 0.35,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "那就根据几乎对联咧，才讲讲湖南什么降雨那个。"
      }
    },
    {
      "id": 35,
      "start": 153.813,
      "end": 156.28,
      "label": "guilin",
      "text": "好像我有点迷惘了，是搞不清楚。",
      "score": 0.2344,
      "wav": "",
      "signals": {
        "mand_logprob": -0.9185,
        "sc_logprob": -0.9518,
        "sc_delta": -0.0333,
        "acoustic_dev": 0.18,
        "seg_cer": 0.308,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "好像我还有点疑问，那是搞不清楚。"
      }
    },
    {
      "id": 36,
      "start": 156.7,
      "end": 161.72,
      "label": "guilin",
      "text": "哪里讲是钱姓？这小王老是。也就是讲，有人们是上世百年的，",
      "score": 0.7513,
      "wav": "",
      "signals": {
        "mand_logprob": -2.5828,
        "sc_logprob": -2.5325,
        "sc_delta": 0.0503,
        "acoustic_dev": 1.0,
        "seg_cer": 0.667,
        "lang_free": "Chinese",
        "phon_confuse": 0.125,
        "phon_examples": "世/四 上/三",
        "lexicon": "么子",
        "text_free": "到底就是些钱些，都想忘了。也就是说，有那么子三四百年的。"
      }
    },
    {
      "id": 37,
      "start": 162.137,
      "end": 166.612,
      "label": "guilin",
      "text": "讲就写得要有啥子了。凤州民歌少讲，",
      "score": 0.7078,
      "wav": "",
      "signals": {
        "mand_logprob": -2.7985,
        "sc_logprob": -2.7763,
        "sc_delta": 0.0222,
        "acoustic_dev": 1.0,
        "seg_cer": 0.8,
        "lang_free": "Chinese",
        "phon_confuse": 0.111,
        "phon_examples": "了/呢",
        "lexicon": "",
        "text_free": "讲的有意思，有有啥子问题呢？冯仲民敢说讲。"
      }
    },
    {
      "id": 38,
      "start": 166.612,
      "end": 171.366,
      "label": "guilin",
      "text": "康熙后期，始祖凤侯昌、凤侯胜两公携家小，",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2919,
        "sc_logprob": -0.2844,
        "sc_delta": 0.0076,
        "acoustic_dev": 0.0,
        "seg_cer": 0.412,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "康熙后期，师祖冯后昌、冯后生两公，皆家小。"
      }
    },
    {
      "id": 39,
      "start": 171.366,
      "end": 175.81,
      "label": "guilin",
      "text": "先从源头凤头寨、玉头山龙尾四江一带，",
      "score": 0.2017,
      "wav": "",
      "signals": {
        "mand_logprob": -0.373,
        "sc_logprob": -0.397,
        "sc_delta": -0.024,
        "acoustic_dev": 0.0,
        "seg_cer": 0.375,
        "lang_free": "Chinese",
        "phon_confuse": 0.167,
        "phon_examples": "四/石",
        "lexicon": "",
        "text_free": "先从袁口风头寨、鱼头山、龙尾石匠一带。"
      }
    },
    {
      "id": 40,
      "start": 175.852,
      "end": 179.135,
      "label": "guilin",
      "text": "经历数百里，来到凤安罗角坨坊。",
      "score": 0.2959,
      "wav": "",
      "signals": {
        "mand_logprob": -1.0265,
        "sc_logprob": -1.0129,
        "sc_delta": 0.0136,
        "acoustic_dev": 0.261,
        "seg_cer": 0.538,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "经历数百年，来到峰岸，落脚脱荒。"
      }
    },
    {
      "id": 41,
      "start": 179.135,
      "end": 182.119,
      "label": "guilin",
      "text": "如今已经传了第十五代。",
      "score": 0.26,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3004,
        "sc_logprob": -0.3097,
        "sc_delta": -0.0092,
        "acoustic_dev": 0.0,
        "seg_cer": 0.4,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "十/四 今/井",
        "lexicon": "",
        "text_free": "油井已经穿了第四五代。"
      }
    },
    {
      "id": 42,
      "start": 184.19,
      "end": 187.623,
      "label": "guilin",
      "text": "从这种建筑形式啊，和现在这种基盘，",
      "score": 0.1219,
