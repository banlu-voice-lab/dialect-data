        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "通过我们走到去看那个街砖，可以看得出。"
      }
    },
    {
      "id": 46,
      "start": 198.214,
      "end": 201.989,
      "label": "guilin",
      "text": "就是这两兄弟啊，善于后辈以后，",
      "score": 0.4082,
