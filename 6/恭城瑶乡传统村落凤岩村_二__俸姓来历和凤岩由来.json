        "lang_free": "Chinese",
        "phon_confuse": 0.111,
        "phon_examples": "上/三",
        "lexicon": "啵",
        "text_free": "嗯，那到吉克，可能算克有三十八年，那是可能啵。"
      }
    },
    {
      "id": 13,
      "start": 67.905,
      "end": 70.201,
      "label": "guilin",
      "text": "有没有讲往东从哪个地方迁来的呢？",
