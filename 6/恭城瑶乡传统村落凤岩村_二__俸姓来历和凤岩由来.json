        "seg_cer": 0.294,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "发展起来了。哦，说明起来以后，我看来。"
      }
    },
    {
      "id": 45,
      "start": 194.86,
      "end": 198.074,
      "label": "guilin",
      "text": "从我们走到去看那个建筑，可以看得出，",
