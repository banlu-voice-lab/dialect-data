    {
      "id": 6,
      "start": 28.996,
      "end": 35.099,
      "label": "guilin",
      "text": "凤安村是一个有座四百八十多户、一千五百多人的瑶族村寨。",
      "score": 0.0914,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0431,
        "sc_logprob": -0.0413,
        "sc_delta": 0.0017,
        "acoustic_dev": 0.0,
        "seg_cer": 0.2,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "凤安城是一个有座四百八十多户、一千五百多英的窑族城镇。"
      }
    },
    {
      "id": 7,
      "start": 35.225,
      "end": 38.62,
      "label": "guilin",
      "text": "全村以凤姓为主，还有凤、",
