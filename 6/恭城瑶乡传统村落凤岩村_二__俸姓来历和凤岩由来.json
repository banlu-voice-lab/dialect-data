        "sc_delta": -0.0298,
        "acoustic_dev": 0.523,
        "seg_cer": 0.357,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我是讲真话的，就讲是从前要懂。"
      }
    },
    {
      "id": 16,
      "start": 77.217,
      "end": 81.02,
      "label": "guilin",
      "text": "钱家洞啊，就是官阳和湖南交界那地方。",
