        "sc_logprob": -0.7137,
        "sc_delta": -0.0355,
        "acoustic_dev": 0.0,
        "seg_cer": 0.308,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一些听老人家讲，我们一百几路。"
      }
    },
    {
      "id": 15,
      "start": 73.679,
      "end": 77.217,
      "label": "guilin",
      "text": "我是讲真话的。嗯，这讲是从钱家洞，",
      "score": 0.4318,
      "wav": "",
      "signals": {
        "mand_logprob": -1.3748,
