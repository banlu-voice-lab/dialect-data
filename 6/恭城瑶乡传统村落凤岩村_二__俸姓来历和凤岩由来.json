        "sc_delta": 0.0309,
        "acoustic_dev": 0.0,
        "seg_cer": 0.267,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "从这种建筑形式啊，和我们现在这种街拍。"
      }
    },
    {
      "id": 43,
      "start": 187.623,
      "end": 191.015,
      "label": "guilin",
      "text": "嗯，是两兄弟传起来的。两兄弟传起来的，两兄弟。",
      "score": 0.1444,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1164,
        "sc_logprob": -0.1583,
        "sc_delta": -0.0419,
        "acoustic_dev": 0.0,
        "seg_cer": 0.316,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "嗯，是两兄弟亲戚来的。两兄弟亲戚来的，两的。"
      }
    },
    {
      "id": 44,
      "start": 191.212,
      "end": 194.86,
      "label": "guilin",
      "text": "发展起来了，你看啊，说明现在以后我看来，",
      "score": 0.4648,
      "wav": "",
      "signals": {
