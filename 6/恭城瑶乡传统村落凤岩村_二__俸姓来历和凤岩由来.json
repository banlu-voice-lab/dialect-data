        "phon_confuse": 0.143,
        "phon_examples": "蓝/南",
        "lexicon": "",
        "text_free": "南江望等星，其中的“风风”两星是占了全城人口的百分之八十以上。"
      }
    },
    {
      "id": 9,
      "start": 46.188,
      "end": 49.27,
      "label": "guilin",
      "text": "凤安村依山傍水，背靠凤山，",
