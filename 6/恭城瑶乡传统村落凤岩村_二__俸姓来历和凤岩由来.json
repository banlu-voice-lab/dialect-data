        "seg_cer": 0.385,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就是这两用地啊，翻淤后背以后。"
      }
    },
    {
      "id": 47,
      "start": 202.035,
      "end": 205.45,
      "label": "guilin",
      "text": "以龙根为主。我讲本来也是那样子，",
