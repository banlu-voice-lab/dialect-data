        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "哪个",
        "text_free": "有没有讲：“把当年从哪家企业来的呢？”"
      }
    },
    {
      "id": 14,
      "start": 70.496,
      "end": 73.679,
      "label": "guilin",
      "text": "一些听老人家讲，我们也不记录，",
      "score": 0.1407,
