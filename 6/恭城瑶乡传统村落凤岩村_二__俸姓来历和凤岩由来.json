        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "全称以缝型为主，还有缝。"
      }
    },
    {
      "id": 8,
      "start": 38.62,
      "end": 45.64,
      "label": "guilin",
      "text": "蓝、江、王等姓。其中的凤、凤两姓是占了全村人口的百分之八十以上。",
      "score": 0.1542,
      "wav": "",
