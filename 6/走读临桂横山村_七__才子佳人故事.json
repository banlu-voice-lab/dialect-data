        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "他在乾隆二十二年（一七五七年）中进士。"
      }
    },
    {
      "id": 8,
      "start": 35.029,
      "end": 38.52,
      "label": "guilin",
      "text": "担任翰林院的编修，也是一个才貌双全",
