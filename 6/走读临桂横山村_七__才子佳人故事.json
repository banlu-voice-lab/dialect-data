        "lang_free": "Chinese",
        "phon_confuse": 0.091,
        "phon_examples": "林/宁",
        "lexicon": "",
        "text_free": "那个产量应该也要控制。宁桂线西乡铁心。"
      }
    },
    {
      "id": 16,
      "start": 71.97,
      "end": 75.287,
      "label": "mandarin",
      "text": "父岳东、乾隆几朝，",
