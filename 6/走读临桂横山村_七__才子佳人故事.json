        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "陈兰生呢，是陈红梅的孙子。"
      }
    },
    {
      "id": 6,
      "start": 27.833,
      "end": 30.786,
      "label": "guilin",
      "text": "前面我们讲过，陈兰生的高风碑，",
      "score": 0.0352,
