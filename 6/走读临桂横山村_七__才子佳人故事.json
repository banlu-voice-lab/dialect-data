        "phon_confuse": 0.167,
        "phon_examples": "字/志",
        "lexicon": "",
        "text_free": "是陈兰生及其府尹主持的墓志。"
      }
    },
    {
      "id": 5,
      "start": 25.14,
      "end": 27.822,
      "label": "guilin",
      "text": "陈兰生呢是陈洪谋的孙子，",
