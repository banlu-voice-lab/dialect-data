        "phon_confuse": 1.0,
        "phon_examples": "住/足",
        "lexicon": "",
        "text_free": "我们经常都讲啊：“衣食足行。”"
      }
    },
    {
      "id": 2,
      "start": 2.904,
      "end": 6.271,
      "label": "guilin",
      "text": "那么这个食字啊，其中呢就占有很大的比重。",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0401,
        "sc_logprob": -0.0349,
        "sc_delta": 0.0053,
