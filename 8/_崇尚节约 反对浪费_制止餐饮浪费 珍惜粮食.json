        "seg_cer": 0.182,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "到要求理性节约，反对浪费。"
      }
    },
    {
      "id": 9,
      "start": 34.188,
      "end": 38.854,
      "label": "mandarin",
      "text": "作为人口大国的中国，粮食浪费量大，人均耕地少，",
      "score": 0.0229,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0014,
        "sc_logprob": -0.0015,
        "sc_delta": -0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.05,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "作为进口大国的中国，粮食浪费量大，人均耕地少。"
      }
    },
    {
      "id": 10,
      "start": 38.854,
      "end": 45.7,
      "label": "mandarin",
      "text": "粮食生产和安全更是维护政治稳定和经济社会健康发展的首要战略问题。",
