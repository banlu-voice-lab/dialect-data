        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "看着你的牙齿刷白了没有？误区一。"
      }
    },
    {
      "id": 6,
      "start": 15.022,
      "end": 18.058,
      "label": "guilin",
      "text": "牙刷刷翻了才丢，一把牙刷用久了，",
