      "start": 122.858,
      "end": 127.149,
      "label": "guilin",
      "text": "需要等待彻底断电以后才能够接触触电者。",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0042,
        "sc_logprob": -0.0038,
        "sc_delta": 0.0004,
