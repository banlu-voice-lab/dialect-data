        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "造成全身烧伤，多处皮肤脱落。"
      }
    },
    {
      "id": 3,
      "start": 10.309,
      "end": 16.206,
      "label": "guilin",
      "text": "那对于遇到这种触电情况发生的时候，我们应该如何救助呢？",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0039,
        "sc_logprob": -0.0034,
        "sc_delta": 0.0005,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那对于遇到这种触电情况发生的时候，我们应该如何救助呢？"
      }
    },
    {
      "id": 4,
      "start": 16.206,
      "end": 21.534,
      "label": "guilin",
      "text": "今天就跟到小编一起来学习一下触电的急救知识。",
      "score": 0.0653,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0049,
        "sc_logprob": -0.0048,
        "sc_delta": 0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.143,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今天就跟到小便一起来学习一下助电力急救知识。"
      }
    },
    {
      "id": 5,
      "start": 21.723,
      "end": 29.357,
      "label": "guilin",
      "text": "当发现有人触电，首先立即用不导电的干木棍或者是绝缘杆把电源线拨开，",
      "score": 0.0357,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0117,
        "sc_logprob": -0.0117,
        "sc_delta": 0.0001,
        "acoustic_dev": 0.012,
        "seg_cer": 0.065,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "当发现有人触电，首先立即用不导电的杆木棍或者是绝缘杆，把电源先拨开。"
      }
    },
    {
      "id": 6,
      "start": 29.505,
      "end": 33.585,
      "label": "mandarin",
      "text": "或者是立即关闭电闸，使触电者脱离危险。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0001,
        "sc_logprob": -0.0001,
        "sc_delta": -0.0,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "或者是立即关闭电闸，使触电者脱离危险。"
      }
    },
    {
      "id": 7,
      "start": 33.728,
      "end": 37.965,
      "label": "guilin",
      "text": "然后呼唤触电者的姓名，判断其是否有意识，",
      "score": 0.2014,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0267,
        "sc_logprob": -0.0254,
        "sc_delta": 0.0013,
        "acoustic_dev": 0.072,
        "seg_cer": 0.222,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "呼/复",
        "lexicon": "",
        "text_free": "然后复翻做点者的姓名，判断其是否有意识。"
      }
    },
    {
      "id": 8,
      "start": 38.164,
      "end": 41.102,
      "label": "mandarin",
      "text": "看其呼吸、脉搏是否正常，",
      "score": 0.1077,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0606,
        "sc_logprob": -0.0727,
        "sc_delta": -0.0121,
        "acoustic_dev": 0.207,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "看其呼吸脉搏是否正常。"
      }
    },
    {
      "id": 9,
      "start": 41.319,
      "end": 44.66,
      "label": "mandarin",
      "text": "而且检查一下触电者是不是有伤口。",
      "score": 0.0305,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0011,
        "sc_logprob": -0.0018,
        "sc_delta": -0.0007,
        "acoustic_dev": 0.0,
        "seg_cer": 0.067,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "而且检查一下做电者是不是有伤口。"
      }
    },
    {
      "id": 10,
      "start": 44.851,
      "end": 48.516,
      "label": "guilin",
      "text": "请按照以下步骤对触电者进行施救。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0001,
        "sc_logprob": -0.0001,
        "sc_delta": 0.0,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "请按照以下步骤对触电者进行施救。"
      }
    },
    {
      "id": 11,
      "start": 48.778,
      "end": 52.808,
      "label": "guilin",
      "text": "当触电者意识清醒而且呼吸脉搏正常的时候，",
      "score": 0.032,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0126,
        "sc_logprob": -0.0124,
        "sc_delta": 0.0002,
        "acoustic_dev": 0.015,
        "seg_cer": 0.053,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "当助电者意识清醒，而且呼吸脉搏正常的时候。"
      }
    },
    {
      "id": 12,
      "start": 52.962,
      "end": 55.258,
      "label": "mandarin",
      "text": "让其就地平卧休息。",
      "score": 0.7217,
      "wav": "",
      "signals": {
        "mand_logprob": -0.5638,
        "sc_logprob": -0.6369,
        "sc_delta": -0.0731,
        "acoustic_dev": 1.0,
        "seg_cer": 0.75,
        "lang_free": "Chinese",
        "phon_confuse": 0.167,
        "phon_examples": "平/品",
        "lexicon": "",
        "text_free": "扬起酒底，品我休息。"
      }
    },
    {
      "id": 13,
      "start": 55.258,
      "end": 57.864,
      "label": "mandarin",
      "text": "如果有心悸、面色苍白、",
      "score": 0.5708,
      "wav": "",
      "signals": {
        "mand_logprob": -0.9236,
        "sc_logprob": -0.9696,
        "sc_delta": -0.046,
        "acoustic_dev": 1.0,
        "seg_cer": 0.111,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "如果有心计，面色苍白。"
      }
    },
    {
      "id": 14,
      "start": 57.864,
      "end": 61.912,
      "label": "guilin",
      "text": "头昏乏力以及伤口处疼痛等的症状，",
      "score": 0.1173,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0652,
        "sc_logprob": -0.0545,
        "sc_delta": 0.0106,
        "acoustic_dev": 0.225,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "头昏乏力，以及伤口处疼痛等的症状。"
      }
    },
    {
      "id": 15,
      "start": 61.912,
      "end": 65.671,
      "label": "mandarin",
      "text": "就要及时就医。当触电者意识不清、",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0012,
        "sc_logprob": -0.0021,
        "sc_delta": -0.0008,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就要及时就医。当触电者意识不清。"
      }
    },
    {
      "id": 16,
      "start": 65.671,
      "end": 71.74,
      "label": "guilin",
      "text": "呼吸脉搏正常的时候，需要将触电者翻转至侧卧位，",
      "score": 0.0218,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0017,
        "sc_logprob": -0.0016,
        "sc_delta": 0.0002,
        "acoustic_dev": 0.0,
        "seg_cer": 0.048,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "呼吸脉搏正常的时候，需要将助电者翻转至侧卧位。"
      }
    },
    {
      "id": 17,
      "start": 71.74,
      "end": 76.432,
      "label": "mandarin",
      "text": "防止误吸。抬起触电者的左臂放到头的一侧，",
      "score": 0.5942,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2175,
        "sc_logprob": -0.2322,
        "sc_delta": -0.0147,
        "acoustic_dev": 0.835,
        "seg_cer": 0.389,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "放置屋细，抬起助垫车的左臂，放到头的一侧。"
      }
    },
    {
      "id": 18,
      "start": 76.532,
      "end": 78.684,
      "label": "guilin",
      "text": "将其右手放到胸口上，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0008,
        "sc_logprob": -0.0008,
        "sc_delta": 0.0,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "将其右手放到胸口上。"
