    {
      "id": 26,
      "start": 108.72,
      "end": 113.435,
      "label": "mandarin",
      "text": "现场对触电者进行施救的时候，一定要注意切断电源，",
      "score": 0.1039,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0075,
        "sc_logprob": -0.0075,
        "sc_delta": -0.0,
