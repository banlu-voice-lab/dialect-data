        "sc_logprob": -0.0179,
        "sc_delta": -0.0033,
        "acoustic_dev": 0.023,
        "seg_cer": 0.182,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "如果坠点者是从高空坠落。"
      }
    },
