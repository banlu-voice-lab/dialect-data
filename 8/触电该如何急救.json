      "label": "mandarin",
      "text": "前几天在桃花江边，一位垂钓爱好者在甩竿的时候误碰到了高压电线，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0018,
        "sc_logprob": -0.0018,
        "sc_delta": -0.0,
