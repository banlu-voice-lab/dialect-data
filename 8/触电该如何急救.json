    },
    {
      "id": 27,
      "start": 113.608,
      "end": 115.866,
      "label": "mandarin",
      "text": "禁止徒手拔开电源。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.002,
        "sc_logprob": -0.0031,
        "sc_delta": -0.0011,
