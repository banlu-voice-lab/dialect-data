        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "前几天，在桃花江边，一位垂钓爱好者在甩竿的时候，误碰到了高压电线。"
      }
    },
    {
      "id": 2,
      "start": 7.276,
      "end": 10.033,
      "label": "guilin",
      "text": "造成全身烧伤、多处皮肤脱落。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0007,
        "sc_logprob": -0.0005,
        "sc_delta": 0.0002,
