        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "当助点者意识不清，而且呼吸脉搏停止的时候，就应该马上对他进行心肺复苏术。"
      }
    },
    {
      "id": 25,
      "start": 105.473,
      "end": 108.378,
      "label": "mandarin",
      "text": "而且拨打幺二零急救电话等待救援。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0024,
        "sc_logprob": -0.0029,
        "sc_delta": -0.0005,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
