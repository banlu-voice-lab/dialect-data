    },
    {
      "id": 29,
      "start": 120.235,
      "end": 122.671,
      "label": "guilin",
      "text": "如果是被高压电电击伤，",
      "score": 0.0056,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0115,
        "sc_logprob": -0.0112,
        "sc_delta": 0.0002,
        "acoustic_dev": 0.011,
