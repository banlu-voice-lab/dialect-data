        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "由于需要长时间漂泊在江面。"
      }
    },
    {
      "id": 12,
      "start": 52.093,
      "end": 57.182,
      "label": "mandarin",
      "text": "而且船上设施简陋，因此制作食物非常不方便。",
      "score": 0.0,
      "wav": "",
      "signals": {
