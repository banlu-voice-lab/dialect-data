        "seg_cer": 0.091,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "船上巴的出现，和杨朔依山傍水的自然环境密不可分。"
      }
    },
    {
      "id": 9,
      "start": 41.149,
      "end": 44.476,
      "label": "mandarin",
      "text": "丽江在杨舍县城境内外沿而过，",
      "score": 0.6607,
