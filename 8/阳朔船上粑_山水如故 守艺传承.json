  "segments": [
    {
      "id": 1,
      "start": 0.001,
      "end": 4.294,
      "label": "guilin",
      "text": "今天我们去杨舍去品尝一道美食——串上巴。",
      "score": 0.6081,
      "wav": "",
      "signals": {
        "mand_logprob": -0.8985,
        "sc_logprob": -0.8522,
        "sc_delta": 0.0463,
        "acoustic_dev": 0.911,
        "seg_cer": 0.294,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "接着，我们去阳朔，去品尝一道美食，串上吧。"
      }
    },
    {
      "id": 2,
      "start": 4.62,
      "end": 12.197,
      "label": "mandarin",
      "text": "杨舍串上巴是一种历史悠久、深受人民欢迎的特色民间传统小吃，",
      "score": 0.0508,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0039,
        "sc_logprob": -0.0046,
        "sc_delta": -0.0007,
        "acoustic_dev": 0.0,
        "seg_cer": 0.111,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "杨锁串串粑是一种历史悠久、深受人民欢迎的特色民间传统小吃。"
      }
    },
    {
      "id": 3,
      "start": 12.401,
      "end": 17.802,
      "label": "mandarin",
      "text": "也是二零二二年桂林市级非物质文化遗产代表性项目之一。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0002,
        "sc_logprob": -0.0004,
        "sc_delta": -0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "也是二零二二年桂林市级非物质文化遗产代表性项目之一。"
      }
    },
    {
      "id": 4,
      "start": 18.044,
      "end": 23.721,
      "label": "mandarin",
      "text": "经过几代人的传承，串上巴的意义早就已经悄然变化了。",
      "score": 0.0596,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0559,
        "sc_logprob": -0.0592,
        "sc_delta": -0.0033,
        "acoustic_dev": 0.0,
        "seg_cer": 0.13,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "经过几代人的传承，船商吧的意义早就已经悄然变化了。"
      }
    },
    {
      "id": 5,
      "start": 23.913,
      "end": 28.169,
      "label": "guilin",
      "text": "风味与物产在漫长的岁月当中不断的蜕变，",
      "score": 0.1816,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1544,
        "sc_logprob": -0.1357,
        "sc_delta": 0.0187,
        "acoustic_dev": 0.042,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "产/餐",
        "lexicon": "",
        "text_free": "风味与午餐在漫长的岁月当中不断地蜕变。"
      }
    },
    {
      "id": 6,
      "start": 28.169,
      "end": 31.884,
      "label": "guilin",
      "text": "但是风土与人情一沿如故，",
      "score": 0.6447,
      "wav": "",
      "signals": {
        "mand_logprob": -0.9834,
        "sc_logprob": -0.9494,
        "sc_delta": 0.034,
        "acoustic_dev": 1.0,
        "seg_cer": 0.273,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "但是，风土与人情一言又过。"
      }
    },
    {
      "id": 7,
      "start": 31.884,
      "end": 35.488,
      "label": "mandarin",
      "text": "养育着一代又一代的杨舍人。",
      "score": 0.0762,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0184,
        "sc_logprob": -0.0193,
