        "seg_cer": 0.158,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "孕育出了一批以水而居、靠水为生的船上赢家。"
      }
    },
    {
      "id": 11,
      "start": 49.253,
      "end": 52.093,
      "label": "mandarin",
      "text": "由于需要长时间漂泊在江面，",
      "score": 0.0,
