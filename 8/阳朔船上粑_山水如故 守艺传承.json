        "seg_cer": 0.308,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "丽江在阳朔县城境内蜿蜒而过。"
      }
    },
    {
      "id": 10,
      "start": 44.642,
      "end": 48.79,
      "label": "mandarin",
      "text": "孕育出了一批依水而居、靠水为生的串上人家。",
      "score": 0.0722,
      "wav": "",
      "signals": {
