        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "而且船上设施简陋，因此制作食物非常不方便。"
      }
    },
    {
      "id": 13,
      "start": 57.287,
      "end": 60.495,
      "label": "mandarin",
      "text": "为了漂泊在外途中的食物供应，",
