        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "养育着一代又一代的杨朔影。"
      }
    },
    {
      "id": 8,
      "start": 35.816,
      "end": 40.856,
      "label": "mandarin",
      "text": "串上巴的出现和杨舍依山傍水的自然环境密不可分。",
