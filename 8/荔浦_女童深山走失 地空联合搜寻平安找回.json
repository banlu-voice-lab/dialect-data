        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "有河流围绕，地势呢比较复杂。"
      }
    },
    {
      "id": 12,
      "start": 51.416,
      "end": 55.326,
      "label": "guilin",
      "text": "山里的气温特别低，加上九号晚上下了一夜的雨，",
