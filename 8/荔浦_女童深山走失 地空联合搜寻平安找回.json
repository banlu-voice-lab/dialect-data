    },
    {
      "id": 22,
      "start": 87.323,
      "end": 90.338,
      "label": "mandarin",
      "text": "特别虚弱的就靠到那里。没怕吧？",
      "score": 0.5266,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6161,
        "sc_logprob": -0.6873,
        "sc_delta": -0.0712,
        "acoustic_dev": 0.705,
        "seg_cer": 0.385,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "特别虚弱的，就靠到那去。慢爬，慢爬。"
      }
    },
    {
      "id": 23,
      "start": 91.36,
      "end": 95.558,
      "label": "guilin",
      "text": "今天补好保险吗？没出水是吗？你说哪？",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -2.18,
        "sc_logprob": -2.1039,
        "sc_delta": 0.0761,
        "acoustic_dev": 1.0,
        "seg_cer": 0.667,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "真的不好吧，行吗？回宿舍行吗？你走哪？"
      }
    },
