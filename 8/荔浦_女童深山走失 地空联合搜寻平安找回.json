      "id": 24,
      "start": 95.558,
      "end": 98.049,
      "label": "mandarin",
      "text": "你说上面下来一下。来吧来吧。不怕啊！",
      "score": 0.6114,
      "wav": "",
      "signals": {
        "mand_logprob": -1.0933,
        "sc_logprob": -1.1128,
        "sc_delta": -0.0195,
        "acoustic_dev": 1.0,
        "seg_cer": 0.2,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "你从上面下来一下，来吧，来吧，播放啊。"
      }
    },
