        "sc_logprob": -0.0118,
        "sc_delta": -0.0002,
        "acoustic_dev": 0.0,
        "seg_cer": 0.083,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "带到警圈，无人机采用警圈追踪、搜索与无人机结合的战术。"
      }
    },
    {
      "id": 10,
      "start": 43.762,
      "end": 48.819,
      "label": "mandarin",
      "text": "开展了地毯式的搜寻。大江村周边山林广阔而且繁茂，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.07,
        "sc_logprob": -0.0771,
        "sc_delta": -0.0071,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "开展了地毯式的搜寻。大江村周边山林广阔，而且繁茂。"
      }
    },
    {
      "id": 11,
      "start": 48.819,
      "end": 51.416,
      "label": "guilin",
      "text": "有河流围绕，地势呢比较复杂，",
      "score": 0.0,
