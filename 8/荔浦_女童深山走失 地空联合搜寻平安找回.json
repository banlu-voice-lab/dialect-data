        "lang_free": "Chinese",
        "phon_confuse": 0.077,
        "phon_examples": "女/绿",
        "lexicon": "嘞",
        "text_free": "是灯外家家啊！记得呢，民警一路北到绿白，原路返回，爬出了山窝窝。"
      }
    },
