      "score": 0.0241,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0603,
        "sc_logprob": -0.0633,
        "sc_delta": -0.0029,
        "acoustic_dev": 0.0,
        "seg_cer": 0.053,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就在大家一路搜寻的时候，十号下午三点钟左右。"
