        "sc_logprob": -0.0354,
        "sc_delta": -0.0077,
        "acoustic_dev": 0.035,
        "seg_cer": 0.074,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "真的是不长胖苗的。其实无糖碳酸饮料并不是真的一点不含糖。"
      }
    },
    {
