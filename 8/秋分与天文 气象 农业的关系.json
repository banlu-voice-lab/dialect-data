        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "太阳沿着方道运行一周，共三百六十度。"
      }
    },
    {
      "id": 8,
      "start": 30.776,
      "end": 33.637,
      "label": "mandarin",
      "text": "每走过十五度就迎来一个新节气。",
