        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "秋分与天文气象和农业到底有哪些关系呢？"
      }
    },
    {
      "id": 6,
      "start": 24.14,
      "end": 27.286,
      "label": "mandarin",
      "text": "我们接着聊盖子。据天文专家介绍，",
      "score": 0.0474,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0328,
        "sc_logprob": -0.0405,
        "sc_delta": -0.0078,
