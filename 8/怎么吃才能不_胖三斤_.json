        "seg_cer": 0.091,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "杂/炸",
        "lexicon": "",
        "text_free": "以选取清蒸或水煮，尽量做到低盐低脂，少吃煎炸食物。"
      }
    },
    {
      "id": 11,
      "start": 37.175,
      "end": 39.715,
      "label": "guilin",
