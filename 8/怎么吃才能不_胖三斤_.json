        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "总/种",
        "lexicon": "",
        "text_free": "应该控制好摄入的种类量或食物种类。"
      }
    },
    {
      "id": 8,
      "start": 25.776,
      "end": 28.207,
      "label": "mandarin",
      "text": "具体建议可以从三方面做起：",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0271,
        "sc_logprob": -0.0274,
        "sc_delta": -0.0003,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "具体建议可以从三方面做起。"
      }
    },
    {
      "id": 9,
      "start": 28.635,
      "end": 30.816,
      "label": "guilin",
      "text": "一是食物的烹饪方式，",
      "score": 0.374,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3082,
        "sc_logprob": -0.264,
        "sc_delta": 0.0443,
