        "seg_cer": 0.333,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一是实物的供应方式。"
      }
    },
    {
      "id": 10,
      "start": 31.08,
      "end": 36.838,
      "label": "mandarin",
      "text": "以选取清蒸或水煮，尽量做到低盐低脂，少吃减杂食物；",
      "score": 0.1416,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0088,
        "sc_logprob": -0.0099,
        "sc_delta": -0.0011,
