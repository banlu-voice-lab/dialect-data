        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "月饼是美食，但是呢，它富含大量油脂，还有糖分啊，不宜过量食用。"
      }
    },
    {
      "id": 3,
      "start": 11.563,
      "end": 14.724,
      "label": "mandarin",
      "text": "那么吃月饼它到底有哪些讲究？",
      "score": 0.202,
      "wav": "",
      "signals": {
        "mand_logprob": -0.19,
        "sc_logprob": -0.2253,
        "sc_delta": -0.0353,
