        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "中秋节现在可能是过过无聊，那个月饼都打得一得啊。"
      }
    },
    {
      "id": 2,
      "start": 4.847,
      "end": 11.396,
      "label": "mandarin",
      "text": "月饼是美食，但是呢，它富含大量的油脂还有糖分啊，不宜过量食用。",
      "score": 0.0169,
      "wav": "",
      "signals": {
        "mand_logprob": -0.003,
        "sc_logprob": -0.0031,
        "sc_delta": -0.0001,
