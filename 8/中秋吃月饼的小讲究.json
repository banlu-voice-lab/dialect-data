        "phon_examples": "",
        "lexicon": "",
        "text_free": "尤其是一些特殊的月饼，比如雪花水果冰淇淋月饼等等。"
      }
    },
    {
      "id": 6,
      "start": 27.21,
      "end": 30.083,
      "label": "guilin",
