    {
      "id": 7,
      "start": 30.379,
      "end": 36.46,
      "label": "mandarin",
      "text": "无糖月饼不可多吃。制作无糖月饼使用的淀粉类原料或是用油，",
      "score": 0.0,
      "wav": "",
