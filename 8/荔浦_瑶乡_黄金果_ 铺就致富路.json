        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "但是呢，它就为村民带来了个比较可观的经济效益。"
      }
    },
    {
      "id": 4,
      "start": 14.797,
      "end": 22.186,
      "label": "mandarin",
      "text": "我的记者呢，去到了普卢瑶族乡黎村村种植户黎科发和杨小凤的黄金百香果园里面，",
      "score": 0.0922,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1376,
        "sc_logprob": -0.1614,
        "sc_delta": -0.0238,
        "acoustic_dev": 0.077,
        "seg_cer": 0.114,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我的记者呢，去到了普路瑶族乡黎村村种植户黎科发和杨晓峰的黄金白香果园里面。"
      }
    },
    {
      "id": 5,
      "start": 22.254,
      "end": 25.038,
      "label": "mandarin",
      "text": "树挂挂满了一个个甜蜜的炸弹。",
      "score": 0.0703,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0051,
