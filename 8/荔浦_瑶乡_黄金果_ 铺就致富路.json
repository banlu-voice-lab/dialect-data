        "seg_cer": 0.214,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么，这么一个小小的黄金白象果啊。"
      }
    },
    {
      "id": 3,
      "start": 10.46,
      "end": 14.587,
      "label": "mandarin",
      "text": "但是呢，它就为村民带来了个比较可观的经济效益。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0251,
        "sc_logprob": -0.0274,
        "sc_delta": -0.0023,
