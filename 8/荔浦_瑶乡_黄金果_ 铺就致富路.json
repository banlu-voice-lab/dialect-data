        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "他们就决定了要种黄金白香果。"
      }
    },
    {
      "id": 10,
      "start": 42.985,
      "end": 47.029,
