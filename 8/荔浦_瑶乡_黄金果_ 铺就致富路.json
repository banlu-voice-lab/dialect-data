        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "树挂挂满了一颗颗甜蜜的炸弹。"
      }
    },
    {
      "id": 6,
      "start": 25.413,
      "end": 29.316,
      "label": "guilin",
      "text": "你摘一个下来，把它打开看看，瞬间就激活了你的味蕾。",
