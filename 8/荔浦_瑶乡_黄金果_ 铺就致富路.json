        "seg_cer": 0.458,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "负担没那么重了，我就想着回家来。然后人家说：“种这个白菜。”"
      }
    },
    {
      "id": 13,
      "start": 59.049,
      "end": 61.73,
