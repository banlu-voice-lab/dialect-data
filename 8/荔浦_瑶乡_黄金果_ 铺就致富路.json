        "seg_cer": 0.292,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就想创业，想发展。这了解到黄金白相果的价值和赏几首呢？"
      }
    },
    {
      "id": 9,
      "start": 39.561,
      "end": 42.284,
      "label": "mandarin",
      "text": "他们就决定了要种黄金百香果。",
