        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "张小强将水月洞改名为朝阳洞。"
      }
    },
    {
      "id": 12,
      "start": 51.623,
      "end": 56.419,
      "label": "mandarin",
      "text": "后来便离开桂林。几年之后，范成大来到了桂林。",
