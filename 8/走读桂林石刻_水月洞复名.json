        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "后来便离开桂林。七年之后，范成大来到了桂林。"
      }
    },
    {
      "id": 13,
      "start": 56.507,
      "end": 60.7,
      "label": "mandarin",
      "text": "范成大字子正，号石湖居士，",
