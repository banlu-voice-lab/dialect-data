        "seg_cer": 0.154,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "十月的阳朔，青山绿水，一眼美丽。"
      }
    },
    {
      "id": 5,
      "start": 24.747,
      "end": 28.593,
      "label": "guilin",
      "text": "中午一点多的漓江龙头山码头，游船游至，",
