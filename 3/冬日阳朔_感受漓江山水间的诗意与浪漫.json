        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "还是海外的朋友，都能够找到那份属于自己的宁静和美好。"
      }
    },
    {
      "id": 4,
      "start": 20.82,
      "end": 24.559,
      "label": "mandarin",
      "text": "十月的阳朔，青山绿水依然美丽。",
      "score": 0.1097,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0273,
