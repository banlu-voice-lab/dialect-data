        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "永福的糍粑，龙胜的豆腐，酿等等。"
      }
    },
    {
      "id": 3,
      "start": 8.207,
      "end": 13.497,
      "label": "mandarin",
      "text": "这些传统的年食总能够勾起人们的年味记忆。",
      "score": 0.0516,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0441,
        "acoustic_dev": 0.007,
        "seg_cer": 0.105,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这些传统的电视总能够勾起人们的年味记忆。"
      }
    },
    {
      "id": 4,
      "start": 13.622,
      "end": 19.723,
      "label": "mandarin",
      "text": "打糍粑是永福县宝里镇和顺村三顺屯瑶族同胞的传统习俗。",
      "score": 0.1366,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0401,
        "acoustic_dev": 0.0,
        "seg_cer": 0.08,
        "lang_free": "Chinese",
        "phon_confuse": 1.0,
        "phon_examples": "顺/孙 顺/孙",
        "lexicon": "",
        "text_free": "打糍粑是永福县宝里镇和孙村三孙屯瑶族同胞的传统习俗。"
      }
    },
    {
      "id": 5,
      "start": 19.948,
      "end": 24.343,
      "label": "mandarin",
      "text": "每年腊月，当地群众就开始扶朋泛友打糍粑。",
      "score": 0.0762,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0151,
        "acoustic_dev": 0.0,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "每年腊月，当地群众就开始扶棚翻油打糍粑。"
      }
    },
    {
      "id": 6,
      "start": 24.634,
      "end": 31.423,
      "label": "mandarin",
      "text": "永福县的非物质文化遗产“防子子糍粑”在糍粑当中加入了防子子成分，",
      "score": 0.2286,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0793,
        "acoustic_dev": 0.065,
        "seg_cer": 0.207,
        "lang_free": "Chinese",
        "phon_confuse": 0.667,
        "phon_examples": "子/之 子/织 子/之 子/织",
        "lexicon": "",
        "text_free": "永福县的非物质文化遗产纺织之糍粑，在糍粑当中加入了纺织之成分。"
      }
    },
    {
      "id": 7,
      "start": 31.812,
      "end": 35.305,
      "label": "guilin",
      "text": "既可增加美观，又可以防叶谢火，",
      "score": 0.5903,
      "wav": "",
      "signals": {
        "mand_logprob": -0.638,
        "acoustic_dev": 1.0,
        "seg_cer": 0.154,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "既可增加美观，又可以防野泄火。"
      }
    },
    {
      "id": 8,
      "start": 35.483,
      "end": 38.143,
      "label": "mandarin",
      "text": "是永福人喜爱的特色美食。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0331,
        "acoustic_dev": 0.0,
