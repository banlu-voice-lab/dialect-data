        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "是永福人喜爱的特色美食。"
      }
    },
    {
      "id": 9,
      "start": 38.586,
      "end": 43.888,
      "label": "mandarin",
      "text": "此外，和顺瑶族村民的特色小米糍粑、玉米糍粑、",
      "score": 0.1962,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0174,
        "acoustic_dev": 0.0,
        "seg_cer": 0.211,
