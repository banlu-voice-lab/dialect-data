    {
      "id": 1,
      "start": 0.19,
      "end": 5.335,
      "label": "mandarin",
      "text": "这段时间啊，国县乡村年味变得是更加的浓了。",
      "score": 0.0802,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0494,
        "acoustic_dev": 0.016,
        "seg_cer": 0.158,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这段时间啊，各县乡村面貌变得是更加的浓了。"
      }
    },
    {
      "id": 2,
      "start": 5.335,
      "end": 7.978,
      "label": "mandarin",
      "text": "永福的糍粑、龙胜的豆腐酿等等，",
      "score": 0.2014,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2717,
