        "phon_confuse": 0.5,
        "phon_examples": "民/名 族/主",
        "lexicon": "",
        "text_free": "此外，和顺窑主成名的特色小米糍粑、玉米糍粑。"
      }
    },
    {
      "id": 10,
      "start": 43.888,
      "end": 47.404,
      "label": "mandarin",
      "text": "木薯糍粑也是别具滋味。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0033,
        "acoustic_dev": 0.0,
