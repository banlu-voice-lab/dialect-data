        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "屋里",
        "text_free": "今天堂屋里头走理发。"
      }
    },
    {
      "id": 14,
      "start": 62.13,
      "end": 65.737,
      "label": "mandarin",
      "text": "今天我们开始做年花了。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0007,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今天我们开始做年花了。"
      }
    },
    {
      "id": 15,
      "start": 65.737,
      "end": 71.406,
      "label": "guilin",
      "text": "做年花的材料必须要用我们泉州乡的糯米，",
      "score": 0.6867,
      "wav": "",
      "signals": {
        "mand_logprob": -0.7617,
        "acoustic_dev": 0.98,
        "seg_cer": 0.278,
        "lang_free": "Chinese",
        "phon_confuse": 0.2,
        "phon_examples": "年/莲",
        "lexicon": "",
        "text_free": "做莲花的材料必须要用我们全球上等糯米。"
      }
    },
    {
      "id": 16,
      "start": 71.406,
      "end": 76.448,
      "label": "mandarin",
      "text": "一般五斤糯米，还要掺一斤籼米，",
      "score": 0.0352,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0155,
