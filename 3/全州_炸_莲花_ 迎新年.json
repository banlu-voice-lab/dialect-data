        "phon_confuse": 1.0,
        "phon_examples": "年/莲",
        "lexicon": "",
        "text_free": "这样做出来的莲花才能酥香脆，口感好。"
      }
    },
    {
      "id": 18,
      "start": 84.056,
      "end": 88.97,
      "label": "mandarin",
      "text": "做年花之前要烧一锅红糖水和糯米粉搅拌，揉成粉团，",
