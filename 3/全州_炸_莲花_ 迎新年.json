  "segments": [
    {
      "id": 1,
      "start": 0.599,
      "end": 6.406,
      "label": "uncertain",
      "text": "在贵博泉州，有着过年吃年花来年才能发那种讲法，",
      "score": 0.5128,
      "wav": "",
      "signals": {
        "mand_logprob": -0.614,
        "acoustic_dev": 0.777,
        "seg_cer": 0.238,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在贵州全州，有做“过年吃年花，来年才能发”的这种讲法。"
      }
    },
    {
      "id": 2,
      "start": 6.581,
      "end": 12.114,
      "label": "mandarin",
      "text": "因此呢，几乎家家户户过年的时候都会准备年花小吃。",
      "score": 0.0816,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0011,
        "acoustic_dev": 0.0,
        "seg_cer": 0.091,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "因此咧，几乎家家户户过年的时候都会准备年发小吃。"
      }
    },
    {
      "id": 3,
      "start": 12.379,
      "end": 17.34,
      "label": "uncertain",
      "text": "吃年花更是成了当地有志思想全家团聚、",
      "score": 0.4638,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4602,
        "acoustic_dev": 0.565,
        "seg_cer": 0.235,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "志/子",
        "lexicon": "",
        "text_free": "吃年饭更是成了当地游子思乡、全家团聚。"
      }
    },
    {
      "id": 4,
      "start": 17.34,
      "end": 20.299,
      "label": "guilin",
      "text": "莫不客的一道节日记忆。",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -3.348,
        "acoustic_dev": 1.0,
        "seg_cer": 0.9,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "某部科吏一到，皆亦急议。"
      }
    },
    {
      "id": 5,
      "start": 20.841,
      "end": 25.6,
      "label": "uncertain",
      "text": "年花这道传统美食在泉州县有着特定的文化符号，",
      "score": 0.4456,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4719,
        "acoustic_dev": 0.581,
        "seg_cer": 0.095,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "年/连",
        "lexicon": "",
        "text_free": "连发这道传统美食，在泉州县有着特定的文化符号。"
      }
    },
    {
      "id": 6,
      "start": 25.863,
      "end": 29.845,
      "label": "mandarin",
      "text": "它不是大家熟悉的植物，而是一种特色小吃，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0012,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "它不是大家熟悉的植物，而是一种特色小吃。"
      }
    },
    {
      "id": 7,
      "start": 30.075,
      "end": 32.982,
      "label": "mandarin",
      "text": "一种过年一定要吃的小吃。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0178,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一种过年一定要吃的小吃。"
      }
    },
    {
      "id": 8,
      "start": 33.27,
      "end": 38.02,
      "label": "mandarin",
      "text": "因为在泉州方言当中，年花和年发的读音差不多，",
      "score": 0.2274,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1323,
        "acoustic_dev": 0.113,
        "seg_cer": 0.15,
        "lang_free": "Chinese",
        "phon_confuse": 0.667,
        "phon_examples": "年/连 年/连",
        "lexicon": "",
        "text_free": "因为在泉州方言当中，连发和连发的读音差不多。"
      }
    },
    {
      "id": 9,
      "start": 38.333,
      "end": 40.855,
      "label": "uncertain",
      "text": "吃了年花才能年年发，",
      "score": 0.4418,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3039,
        "acoustic_dev": 0.35,
        "seg_cer": 0.444,
        "lang_free": "Chinese",
        "phon_confuse": 0.75,
        "phon_examples": "年/连 年/连 年/连",
        "lexicon": "",
        "text_free": "吃了连发，才能连连发。"
      }
    },
    {
      "id": 10,
      "start": 40.855,
      "end": 47.476,
      "label": "mandarin",
      "text": "才更加有年味。年花小吃所带来的年味，除了味蕾上的享受，",
      "score": 0.2143,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0049,
        "acoustic_dev": 0.0,
        "seg_cer": 0.25,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "年/廉 年/廉 年/廉",
        "lexicon": "",
        "text_free": "才更加有廉微。廉法小吃所带来的廉微，除了味蕾上的享受。"
      }
    },
    {
      "id": 11,
      "start": 47.476,
      "end": 50.753,
      "label": "mandarin",
      "text": "更多的是感受制作过程当中的乐趣。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0045,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "更多的是感受制作过程当中的乐趣。"
      }
    },
    {
      "id": 12,
      "start": 51.141,
      "end": 59.127,
      "label": "mandarin",
      "text": "一月七号，记者来到了泉州县北宝乡北宝村委大模港村的村民唐燕秀屋里头，",
      "score": 0.1422,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0931,
        "acoustic_dev": 0.059,
        "seg_cer": 0.156,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "屋里",
        "text_free": "一月七号，记者来到了泉州仙白宝乡白宝村委大漠岗村的村民唐燕秀屋里头。"
      }
    },
    {
      "id": 13,
      "start": 59.402,
      "end": 62.089,
      "label": "guilin",
      "text": "今天，堂屋里头做年花。",
