        "seg_cer": 0.077,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一般五斤糯米，还要掺一斤鲜米。"
      }
    },
    {
      "id": 17,
      "start": 76.448,
      "end": 84.056,
      "label": "mandarin",
      "text": "这样做出来的年花才能酥香脆，口感好。",
      "score": 0.1286,
