        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "他的选择非决定豆腐娘的口味。"
      }
    },
    {
      "id": 11,
      "start": 46.13,
      "end": 51.138,
      "label": "guilin",
      "text": "大多数人会将五花肉、木耳、香葱等馅料粉和剁碎，",
      "score": 0.68,
      "wav": "",
