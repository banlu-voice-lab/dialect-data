        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "大多数鹦飞将无法与母鹅、香葱等闲聊，分伙夺食。"
      }
    },
    {
      "id": 12,
      "start": 51.474,
      "end": 55.37,
      "label": "mandarin",
      "text": "拿起一个炸好的豆腐皮，撕开一个小口子，",
      "score": 0.0,
