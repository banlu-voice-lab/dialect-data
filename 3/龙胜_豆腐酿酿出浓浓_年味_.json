        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "拿起一个炸好的豆腐皮，撕开一个小口子。"
      }
    },
    {
      "id": 13,
      "start": 55.6,
      "end": 61.367,
      "label": "mandarin",
      "text": "把馅料裹入其中。包好的豆腐酿放到柴火灶高头蒸煮，",
      "score": 0.0,
      "wav": "",
      "signals": {
