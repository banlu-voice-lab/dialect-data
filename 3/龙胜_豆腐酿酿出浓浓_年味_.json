        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "把馅料裹入其中，包好的豆腐酿放到柴火灶高头蒸煮。"
      }
    },
    {
      "id": 14,
      "start": 61.61,
      "end": 64.446,
      "label": "mandarin",
      "text": "半个小时以后就可以出锅食用。",
