        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "色泽也从温润的洁白转为油润的金黄。"
      }
    },
    {
      "id": 9,
      "start": 37.279,
      "end": 42.954,
      "label": "mandarin",
      "text": "散发出阵阵香气。馅料是制作豆腐酿的最关键的部分，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0154,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "散发出阵阵香气。馅料是制作豆腐酿的最关键的部分。"
      }
    },
    {
      "id": 10,
      "start": 42.954,
      "end": 45.92,
      "label": "mandarin",
      "text": "它的选择会决定豆腐酿的口味。",
      "score": 0.1417,
