      }
    },
    {
      "id": 6,
      "start": 25.495,
      "end": 29.356,
      "label": "guilin",
      "text": "冬连是龙胜各族自治县的法定假日，",
      "score": 0.6418,
      "wav": "",
      "signals": {
        "mand_logprob": -0.5378,
