        "seg_cer": 0.148,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "活动同时也是吸引了来自四面八方的游客朋友们走进黔灵东站。"
      }
    },
    {
      "id": 5,
      "start": 22.088,
      "end": 25.321,
      "label": "mandarin",
      "text": "体验这开浓郁的民族风情。",
