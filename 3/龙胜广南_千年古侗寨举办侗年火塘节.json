      "label": "mandarin",
      "text": "前段时间，龙胜各族自治县平登镇广南村举办了一年一度的冬连火塘节。",
      "score": 0.0658,
      "wav": "",
      "signals": {
        "mand_logprob": -0.045,
        "acoustic_dev": 0.039,
        "seg_cer": 0.1,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "前段时间，龙胜国族自治县平等镇广南村举办了一年一度的冬练火塘节。"
      }
    },
    {
      "id": 2,
      "start": 7.996,
      "end": 11.164,
      "label": "mandarin",
      "text": "当地侗族同胞身着节日盛装，",
      "score": 0.2504,
      "wav": "",
      "signals": {
        "mand_logprob": -0.064,
        "acoustic_dev": 0.068,
