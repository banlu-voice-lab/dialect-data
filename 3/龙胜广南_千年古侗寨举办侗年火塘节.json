        "phon_confuse": 0.25,
        "phon_examples": "盛/身",
        "lexicon": "",
        "text_free": "当地东族同胞身着简易身装。"
      }
    },
    {
      "id": 3,
      "start": 11.164,
      "end": 14.741,
      "label": "mandarin",
      "text": "欢聚一堂，载歌载舞，欢度冬连。",
      "score": 0.209,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0806,
