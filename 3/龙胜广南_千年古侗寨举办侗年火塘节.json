        "seg_cer": 0.667,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "凡聚一堂，再过再舞，凡多动练。"
      }
    },
    {
      "id": 4,
      "start": 15.077,
      "end": 21.945,
      "label": "mandarin",
      "text": "活动同时，也是吸引了来自四面八方的游客朋友们走进千年侗寨，",
      "score": 0.2752,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2764,
