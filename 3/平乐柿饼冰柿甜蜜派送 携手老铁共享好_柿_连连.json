        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我现在是位于哈尔滨的著名打卡点——中央大街上。"
      }
    },
    {
      "id": 5,
      "start": 26.816,
      "end": 32.302,
      "label": "guilin",
      "text": "我们的老铁老表一家亲桂林平罗士兵甜点新活动就在这里开始了。",
