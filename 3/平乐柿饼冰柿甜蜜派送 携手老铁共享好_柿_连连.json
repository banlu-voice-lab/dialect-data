        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么今天哈尔滨的户外气温是达到了零下二十度。"
      }
    },
    {
