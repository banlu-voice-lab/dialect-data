        "seg_cer": 0.321,
        "lang_free": "Chinese",
        "phon_confuse": 0.222,
        "phon_examples": "林/凌 亲/庆",
        "lexicon": "",
        "text_free": "我们的老铁老表易家庆、顾凌平、乐事饼甜在心活动就在这里开始了。"
      }
    },
    {
      "id": 6,
      "start": 32.302,
      "end": 37.736,
      "label": "mandarin",
      "text": "我们可以看到现场排队来领取我们平罗士兵平罗士兵的人是非常的多。",
