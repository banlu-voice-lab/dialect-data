      }
    },
    {
      "id": 9,
      "start": 42.148,
      "end": 47.432,
      "label": "mandarin",
      "text": "冬意景色的生态美景也吸引了好多市民游客前来打卡，",
      "score": 0.1453,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1591,
