        "mand_logprob": -0.0445,
        "acoustic_dev": 0.032,
        "seg_cer": 0.188,
        "lang_free": "Chinese",
        "phon_confuse": 0.2,
        "phon_examples": "株/组",
        "lexicon": "",
        "text_free": "天水依然是越来越冷，但是临川县海洋乡的白湾组银杏迎来了唐的最佳观赏期。"
      }
    },
    {
      "id": 3,
      "start": 14.661,
      "end": 19.543,
      "label": "mandarin",
      "text": "绚丽的色彩构成了一幅美丽的冬季生态画卷。",
