        "mand_logprob": -0.0111,
        "acoustic_dev": 0.0,
        "seg_cer": 0.071,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在纷纷细雨当中，银杏叶吹风摇曳。"
      }
    },
    {
      "id": 6,
      "start": 29.965,
      "end": 33.225,
      "label": "mandarin",
      "text": "近旁的树叶与远处连绵的青山、",
      "score": 0.2468,
