        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "比去年还要漂亮。我这帮朋友看到的挺开心。"
      }
    },
    {
      "id": 16,
      "start": 71.403,
      "end": 73.911,
      "label": "guilin",
      "text": "不虚此行。今年来，",
