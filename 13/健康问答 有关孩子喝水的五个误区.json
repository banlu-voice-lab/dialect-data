        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "所以下面呢，我和大家讲讲这样子坝灾洪水有哪些典型的误区。"
      }
    },
    {
      "id": 9,
      "start": 28.563,
      "end": 32.191,
      "label": "mandarin",
      "text": "误区一：吃饭的时候喝水，分析是胃液。",
