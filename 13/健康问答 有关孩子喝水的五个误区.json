        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "实际上，食物本身就含有大量水分。"
      }
    },
    {
      "id": 11,
      "start": 35.764,
      "end": 39.728,
      "label": "mandarin",
      "text": "如蔬菜瓜果当中的水分含量超过百分之八十。",
      "score": 0.0,
      "wav": "",
      "signals": {
