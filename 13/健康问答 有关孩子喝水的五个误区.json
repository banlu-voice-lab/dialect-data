      "wav": "",
      "signals": {
        "mand_logprob": -0.0838,
        "sc_logprob": -0.0666,
        "sc_delta": 0.0172,
        "acoustic_dev": 0.051,
        "seg_cer": 0.2,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "误区一：吃饭的时候喝水会稀释胃液。"
      }
    },
    {
      "id": 10,
      "start": 32.497,
      "end": 35.534,
      "label": "mandarin",
      "text": "实际上，食物本身就含有大量水分，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0006,
        "sc_logprob": -0.0008,
