        "sc_logprob": -0.0169,
        "sc_delta": 0.0025,
        "acoustic_dev": 0.0,
        "seg_cer": 0.133,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "东西去了解一下。首先呢，就要端正心态，莫给自己设立一个太高的门槛。"
      }
    },
    {
      "id": 7,
      "start": 27.018,
      "end": 29.592,
      "label": "mandarin",
      "text": "不一定讲要去健身房才算是健身的，",
