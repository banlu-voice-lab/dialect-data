        "mand_logprob": -0.2003,
        "sc_logprob": -0.2344,
        "sc_delta": -0.0341,
        "acoustic_dev": 0.679,
        "seg_cer": 0.059,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一，延伸训练，对于身体集群进行一个拉伸。"
