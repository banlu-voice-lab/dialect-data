        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么越来越多的人呢，就开始加入了运动的生活圈。"
      }
    },
    {
      "id": 4,
      "start": 13.418,
      "end": 16.184,
      "label": "mandarin",
      "text": "希望呢能够摆脱这种亚健康状态。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0049,
        "sc_logprob": -0.0044,
