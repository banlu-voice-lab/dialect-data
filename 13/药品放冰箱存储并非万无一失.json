        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "要严格地执行，比如讲，在银量处。"
      }
    },
    {
      "id": 7,
      "start": 27.398,
      "end": 30.309,
      "label": "mandarin",
      "text": "避开阳光、干燥处、冷藏等等。",
