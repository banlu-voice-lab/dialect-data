    {
      "id": 14,
      "start": 54.707,
      "end": 59.071,
      "label": "mandarin",
      "text": "根据了解啊，平乐县杨安乡种植李子呢有二十多年了，",
      "score": 0.0608,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0459,
        "sc_logprob": -0.0396,
        "sc_delta": 0.0063,
        "acoustic_dev": 0.0,
        "seg_cer": 0.045,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "根据了解啊，平乐县杨安乡种植李子咧，有二十多年了。"
      }
    },
    {
      "id": 15,
      "start": 59.071,
      "end": 62.035,
      "label": "mandarin",
      "text": "主要集中在石面山村和山湖村。",
