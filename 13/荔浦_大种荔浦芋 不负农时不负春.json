        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "老话讲啊：“一年之计在于春，一年好景在春耕。”"
      }
    },
    {
      "id": 2,
      "start": 4.633,
      "end": 8.121,
      "label": "mandarin",
      "text": "立春过后呢，正是春耕的一个关键的时间了。",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0022,
        "sc_logprob": -0.0024,
        "sc_delta": -0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.056,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "立春过后呢，正是春耕的一个关键的时节了。"
      }
    },
    {
      "id": 3,
      "start": 8.294,
      "end": 14.514,
      "label": "mandarin",
      "text": "在荔浦市广坡的田野高头，到处都可以看到群众们在平整土地、种植芋头。",
      "score": 0.0641,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0212,
        "sc_logprob": -0.03,
        "sc_delta": -0.0089,
        "acoustic_dev": 0.006,
        "seg_cer": 0.133,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在利物浦市广阔的田野高头，到处都可以看到群众们在平整土地、种植鱼头。"
      }
    },
    {
      "id": 4,
      "start": 14.624,
      "end": 17.414,
      "label": "mandarin",
      "text": "田间里头呢，也是一片繁忙的景象。",
      "score": 0.138,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0098,
        "sc_logprob": -0.0177,
        "sc_delta": -0.0079,
        "acoustic_dev": 0.0,
        "seg_cer": 0.214,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "天街里头咧，也是一片繁忙的景象。"
      }
    },
    {
      "id": 5,
      "start": 17.69,
      "end": 25.969,
      "label": "mandarin",
      "text": "我的记者啊，去到秀云镇福旺村的马场屯，看到村民呢都聚到一起，在给翻地、起垄、放种甘木。",
      "score": 0.2794,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1175,
        "sc_logprob": -0.1102,
        "sc_delta": 0.0073,
        "acoustic_dev": 0.23,
        "seg_cer": 0.351,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我的地址啊，去到秀银镇富旺村的麻场村，看到村民呢都聚到一起，在给梵帝、启龙、方中干木。"
      }
    },
    {
      "id": 6,
      "start": 26.181,
      "end": 28.865,
      "label": "mandarin",
      "text": "一下子呢，一大块田都已经种完了。",
      "score": 0.0327,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0019,
        "sc_logprob": -0.0023,
        "sc_delta": -0.0005,
        "acoustic_dev": 0.0,
        "seg_cer": 0.071,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一下子呢，一大块田都已经种满了。"
      }
    },
    {
      "id": 7,
      "start": 29.432,
      "end": 32.941,
      "label": "mandarin",
      "text": "荔浦芋园种植合作社的负责人魏兰芬讲啊，",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6315,
        "sc_logprob": -0.6931,
        "sc_delta": -0.0616,
        "acoustic_dev": 1.0,
        "seg_cer": 0.611,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "利物浦球员中志合作社的负责人为难粉红奖啊。"
      }
    },
    {
      "id": 8,
      "start": 33.06,
      "end": 35.407,
      "label": "mandarin",
      "text": "荔浦芋的种植呢还是蛮讲究的，",
      "score": 0.2334,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0276,
        "sc_logprob": -0.0243,
        "sc_delta": 0.0033,
        "acoustic_dev": 0.021,
        "seg_cer": 0.385,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "种/宗",
        "lexicon": "",
        "text_free": "利物浦鱼的宗旨呢，还是蛮讲究的。"
      }
    },
    {
      "id": 9,
      "start": 35.593,
      "end": 38.614,
      "label": "mandarin",
      "text": "每亩田呢要把两千个坑穴，",
      "score": 0.1882,
      "wav": "",
      "signals": {
        "mand_logprob": -0.107,
        "sc_logprob": -0.095,
        "sc_delta": 0.012,
        "acoustic_dev": 0.205,
        "seg_cer": 0.091,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "每亩田咧，要把两千个坑穴。"
      }
    },
    {
      "id": 10,
      "start": 38.813,
      "end": 41.559,
      "label": "mandarin",
      "text": "坑的深度呢在十五到二十公分。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0003,
        "sc_logprob": -0.0003,
        "sc_delta": -0.0,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "坑的深度呢，在十五到二十公分。"
      }
    },
    {
      "id": 11,
      "start": 41.81,
      "end": 45.577,
      "label": "mandarin",
      "text": "这几天呢，他们要把承包的水田全部种完去。",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0086,
        "sc_logprob": -0.0097,
        "sc_delta": -0.0011,
        "acoustic_dev": 0.0,
        "seg_cer": 0.056,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这几天呢，他们要把承包的水田全部种完个。"
      }
    },
    {
      "id": 12,
      "start": 45.712,
      "end": 49.634,
      "label": "mandarin",
      "text": "立春后是我们荔浦种植的最佳时间，",
      "score": 0.2623,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2106,
        "sc_logprob": -0.1907,
        "sc_delta": 0.02,
        "acoustic_dev": 0.446,
        "seg_cer": 0.067,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "立春后，是我们荔浦芋种植的最佳时间。"
      }
    },
    {
      "id": 13,
      "start": 49.729,
      "end": 53.269,
      "label": "mandarin",
      "text": "所以我们就请来工人帮我们种植荔浦芋。",
      "score": 0.0538,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0091,
        "sc_logprob": -0.0073,
        "sc_delta": 0.0018,
        "acoustic_dev": 0.0,
        "seg_cer": 0.118,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "所以我们就请来工人帮我们种植绿浦玉。"
      }
    },
    {
      "id": 14,
      "start": 53.269,
      "end": 58.868,
      "label": "mandarin",
      "text": "魏兰芬有好多年种植荔浦芋的经验了，种出来的芋头不仅是个头大、形状好，",
      "score": 0.3074,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1633,
        "sc_logprob": -0.1697,
        "sc_delta": -0.0064,
        "acoustic_dev": 0.336,
        "seg_cer": 0.29,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "白兰粉有好多年种植荔浦鱼的经验了。中串鱼头啊，不仅是个头大，形状好。"
      }
    },
    {
      "id": 15,
      "start": 58.868,
      "end": 62.333,
      "label": "mandarin",
      "text": "而且呢又特别特别的好吃，受到市场的喜欢。",
      "score": 0.0508,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0167,
        "sc_logprob": -0.0149,
        "sc_delta": 0.0018,
        "acoustic_dev": 0.0,
        "seg_cer": 0.111,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "而且呢，又特别特别的好吃，受到时尚的喜欢。"
      }
    },
    {
      "id": 16,
      "start": 63.714,
      "end": 66.361,
      "label": "mandarin",
      "text": "我们种植荔浦芋有二十多年了，",
