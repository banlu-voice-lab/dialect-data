{
  "schema": "guilin-tts/segments@1",
  "src_audio": "滋润暖身 试试三款银耳羹.wav",
  "duration": 113.02,
  "no_dialect": false,
  "created_at": "2026-10-30T04:27:05",
  "segments": [
    {
      "id": 1,
      "start": 0.025,
      "end": 2.751,
      "label": "guilin",
      "text": "春天到了，但是天气啊杂乱烦寒。",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -5.0032,
        "sc_logprob": -4.9009,
        "sc_delta": 0.1022,
        "acoustic_dev": 1.0,
        "seg_cer": 0.615,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "春天是到了，但是春天咋弄啊？"
      }
    },
    {
      "id": 2,
      "start": 3.16,
      "end": 6.386,
      "label": "guilin",
      "text": "这个季节养生适合呢喝点羹汤，",
      "score": 0.2267,
      "wav": "",
      "signals": {
        "mand_logprob": -3.0052,
        "sc_logprob": -2.8457,
        "sc_delta": 0.1595,
        "acoustic_dev": 0.051,
        "seg_cer": 0.615,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "这个季节咧，就适合喝点汤羹，百搭不爽。"
      }
    },
    {
      "id": 3,
      "start": 7.055,
      "end": 9.757,
      "label": "guilin",
      "text": "博大不爽的银耳是一个非常不错的选择。",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -6.3411,
        "sc_logprob": -5.9575,
        "sc_delta": 0.3836,
        "acoustic_dev": 1.0,
        "seg_cer": 0.706,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就是一个不错的选择，不？一般。"
      }
    },
    {
      "id": 4,
      "start": 10.105,
      "end": 16.428,
      "label": "guilin",
      "text": "熬一碗银耳羹，不仅滋阴润燥，还可以让你的身体暖暖和和的。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.1263,
        "sc_logprob": -0.9804,
        "sc_delta": 0.1458,
        "acoustic_dev": 0.0,
        "seg_cer": 0.84,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "根啊，不仅能够滋阴润燥，还可以给身体面暖暖和和的。下面呢，我号召大家来。"
      }
    },
    {
      "id": 5,
      "start": 16.76,
      "end": 19.8,
      "label": "guilin",
      "text": "下面我们就来介绍三款银耳羹的做法，",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.1887,
        "sc_logprob": -1.1121,
        "sc_delta": 0.0766,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "三款婴儿羹的做法，看着你喜欢喝。"
      }
    },
    {
      "id": 6,
      "start": 20.12,
      "end": 22.382,
      "label": "mandarin",
      "text": "大家记下来，跟到一起做吧。",
      "score": 0.4637,
      "wav": "",
      "signals": {
        "mand_logprob": -3.8716,
        "sc_logprob": -3.8756,
        "sc_delta": -0.004,
        "acoustic_dev": 0.584,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "首先，我们要了解。"
      }
    },
    {
      "id": 7,
      "start": 23.3,
      "end": 28.308,
      "label": "mandarin",
      "text": "首先啊，我们要了解让银耳羹更加软糯香滑的小技巧。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.6866,
        "sc_logprob": -1.6694,
        "sc_delta": 0.0172,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "更加软糯香滑的小技巧：微微泛黄的银耳羹，品质好。"
      }
    },
    {
      "id": 8,
      "start": 28.414,
      "end": 30.779,
      "label": "guilin",
      "text": "微微泛黄的银耳羹品质好，",
      "score": 0.2,
      "wav": "",
      "signals": {
        "mand_logprob": -2.9216,
        "sc_logprob": -2.668,
        "sc_delta": 0.2536,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "营业额多咧，要小而且要密。"
      }
    },
    {
      "id": 9,
      "start": 31.08,
      "end": 34.36,
      "label": "mandarin",
      "text": "银耳的朵呢要小而且要密，这样子呢就容易煮。",
      "score": 0.3991,
      "wav": "",
      "signals": {
        "mand_logprob": -3.6697,
        "sc_logprob": -3.6852,
        "sc_delta": -0.0155,
        "acoustic_dev": 0.46,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就用一煮，泡发的时候呢，可以用冷水蒸。"
      }
    },
    {
      "id": 10,
      "start": 34.592,
      "end": 39.121,
      "label": "mandarin",
      "text": "泡发的时候呢，可以用冷水，这样子可以更好的保留它的胶质。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.8086,
        "sc_logprob": -1.8922,
        "sc_delta": -0.0837,
        "acoustic_dev": 0.0,
        "seg_cer": 0.96,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "更好的保留它的价值，将婴儿根部去掉，剪碎。"
      }
    },
    {
      "id": 11,
      "start": 39.554,
      "end": 42.122,
      "label": "guilin",
      "text": "将银耳根部去掉，剪碎剁碎，",
      "score": 0.6437,
      "wav": "",
      "signals": {
        "mand_logprob": -4.4346,
        "sc_logprob": -4.2618,
        "sc_delta": 0.1728,
        "acoustic_dev": 0.93,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "或者用搅拌机搅得越碎越好。"
      }
    },
    {
      "id": 12,
      "start": 42.122,
      "end": 44.52,
      "label": "guilin",
      "text": "或者用搅拌机搅得越碎越好，",
      "score": 0.3103,
      "wav": "",
      "signals": {
        "mand_logprob": -3.3919,
        "sc_logprob": -3.1638,
        "sc_delta": 0.2281,
        "acoustic_dev": 0.289,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "真的呢，又可以省时间，主萃了。"
      }
    },
    {
      "id": 13,
      "start": 44.84,
      "end": 48.501,
      "label": "guilin",
      "text": "这样子呢又可以省时间，煮出来的银耳会更加的浓。",
      "score": 0.4673,
      "wav": "",
      "signals": {
        "mand_logprob": -3.8831,
        "sc_logprob": -3.7477,
        "sc_delta": 0.1354,
        "acoustic_dev": 0.591,
        "seg_cer": 0.905,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "会更加的浓。红枣银耳羹，紫银。"
      }
    },
    {
      "id": 14,
      "start": 49.08,
      "end": 51.692,
      "label": "guilin",
      "text": "红枣银耳羹，滋阴润肺，",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.7745,
        "sc_logprob": -1.4493,
        "sc_delta": 0.3252,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "养气活血，甘甜可口。"
      }
    },
    {
      "id": 15,
      "start": 51.692,
      "end": 54.04,
      "label": "mandarin",
      "text": "养气活血，甘甜可口。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -2.404,
        "sc_logprob": -2.4313,
        "sc_delta": -0.0273,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "宣国达，武侯何？"
      }
    },
    {
      "id": 16,
      "start": 54.433,
      "end": 58.624,
      "label": "mandarin",
      "text": "选过大、入厚、核小的干枣，洗干净之后呢，",
      "score": 0.2424,
      "wav": "",
      "signals": {
        "mand_logprob": -3.1795,
        "sc_logprob": -3.364,
        "sc_delta": -0.1845,
        "acoustic_dev": 0.159,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "干澡洗干净之后呢，用冷水泡，婴儿呢，用冷水。"
      }
    },
    {
      "id": 17,
      "start": 58.648,
      "end": 61.56,
      "label": "guilin",
      "text": "用温水泡。银耳呢用冷水泡发，",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -5.3957,
        "sc_logprob": -4.8644,
        "sc_delta": 0.5313,
        "acoustic_dev": 1.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "跑法，去掉杂质或梗蒂。"
      }
    },
    {
      "id": 18,
      "start": 61.774,
      "end": 67.72,
      "label": "mandarin",
      "text": "洗掉杂质和根蒂，撕碎和红枣一起放个砂锅里面，小火熬。",
      "score": 0.26,
      "wav": "",
      "signals": {
        "mand_logprob": -1.992,
        "sc_logprob": -2.0026,
        "sc_delta": -0.0106,
        "acoustic_dev": 0.0,
        "seg_cer": 0.739,
        "lang_free": "Chinese",
        "phon_confuse": 1.0,
        "phon_examples": "碎/水",
        "lexicon": "",
        "text_free": "水和红枣一起放个砂锅里面，小火去熬。冰糖雪梨银耳羹。"
      }
    },
    {
      "id": 19,
      "start": 68.6,
      "end": 71.316,
      "label": "guilin",
      "text": "冰糖雪梨银耳羹，清热解毒，",
      "score": 0.4638,
      "wav": "",
      "signals": {
        "mand_logprob": -3.8721,
        "sc_logprob": -3.1665,
        "sc_delta": 0.7056,
        "acoustic_dev": 0.584,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "养眼、营造、牢骚皆已。"
      }
    },
    {
      "id": 20,
      "start": 71.316,
      "end": 73.415,
      "label": "guilin",
      "text": "养颜润燥，老少皆宜。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -2.4734,
        "sc_logprob": -2.3281,
        "sc_delta": 0.1453,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "将婴儿洗干净，泡发。"
      }
    },
    {
      "id": 21,
      "start": 73.606,
      "end": 76.952,
      "label": "guilin",
      "text": "将银耳洗干净，泡发，去根撕碎，",
      "score": 0.3748,
      "wav": "",
      "signals": {
        "mand_logprob": -3.5935,
        "sc_logprob": -3.1663,
        "sc_delta": 0.4273,
        "acoustic_dev": 0.413,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一根丝髓，李子削皮，取虎切生。"
      }
    },
    {
      "id": 22,
      "start": 77.32,
      "end": 79.88,
      "label": "mandarin",
      "text": "梨子削皮去核，切成薄片。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -2.2052,
        "sc_logprob": -2.2358,
        "sc_delta": -0.0306,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "硬饵加水，开大火煮，再改。"
      }
    },
    {
      "id": 23,
      "start": 80.36,
      "end": 83.96,
      "label": "guilin",
      "text": "银耳加水开大火煮，再改小火煮三十分钟，",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -2.6894,
        "sc_logprob": -2.6427,
        "sc_delta": 0.0467,
        "acoustic_dev": 0.0,
        "seg_cer": 0.765,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我煮三十分钟，加油力片，再煮十分钟。"
      }
    },
    {
      "id": 24,
      "start": 84.074,
      "end": 87.179,
      "label": "guilin",
      "text": "加入梨片再煮十分钟，放冰糖，",
      "score": 0.2283,
      "wav": "",
      "signals": {
        "mand_logprob": -3.1353,
        "sc_logprob": -3.0739,
        "sc_delta": 0.0614,
        "acoustic_dev": 0.131,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "冰糖煮到黏黏的，就可以关火。"
      }
    },
    {
      "id": 25,
      "start": 87.4,
      "end": 92.324,
      "label": "guilin",
      "text": "煮到黏黏的就可以关火焖锅把钟头之后呢就可以直接吃了。",
      "score": 0.2531,
      "wav": "",
      "signals": {
        "mand_logprob": -3.0876,
        "sc_logprob": -2.8454,
        "sc_delta": 0.2422,
        "acoustic_dev": 0.102,
        "seg_cer": 0.84,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "过把钟头之后咧，就可以直接吃了。枸杞银耳羹，运费补。"
      }
    },
    {
      "id": 26,
      "start": 92.68,
      "end": 96.36,
      "label": "guilin",
      "text": "枸杞银耳羹，润肺补肾，生津明目，",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.6282,
        "sc_logprob": -1.518,
        "sc_delta": 0.1103,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "身经名目，止步健身，因而依旧。"
      }
    },
    {
      "id": 27,
      "start": 96.6,
      "end": 101.606,
      "label": "guilin",
      "text": "滋补健身。银耳依旧是要洗干净，泡发，去根撕碎。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -2.7087,
        "sc_logprob": -2.489,
        "sc_delta": 0.2197,
        "acoustic_dev": 0.0,
        "seg_cer": 1.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "洗干净，泡发，去根，撕碎。枸杞呢，用清水泡十分钟。"
      }
    },
    {
      "id": 28,
      "start": 101.794,
      "end": 107.938,
      "label": "mandarin",
      "text": "枸杞呢用清水泡十分钟，银耳加水煮开之后转小火煲一个小时，",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -1.6886,
        "sc_logprob": -1.6781,
        "sc_delta": 0.0105,
        "acoustic_dev": 0.0,
        "seg_cer": 0.731,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "银耳加水煮开之后，转小火煲一个小时，加入枸杞子焖煮之后。"
      }
    },
    {
      "id": 29,
      "start": 107.938,
      "end": 113.02,
      "label": "mandarin",
      "text": "加入枸杞子焖煮之后加适量的冰糖调味就可以了。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -2.436,
        "sc_logprob": -2.4468,
        "sc_delta": -0.0108,
        "acoustic_dev": 0.0,
        "seg_cer": 0.429,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "加适量的冰糖调味就可以了。"
      }
    }
  ]
}