        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这预示着他今年的生活肯定红红火火的。"
      }
    },
    {
      "id": 5,
      "start": 23.031,
      "end": 26.267,
      "label": "mandarin",
      "text": "一般来讲啊，番茄呢，每年呢可以种两茬。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0047,
        "sc_logprob": -0.0051,
        "sc_delta": -0.0004,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一般来讲啊，番茄呢，每年呢可以种两茬。"
      }
    },
    {
      "id": 6,
      "start": 26.65,
      "end": 30.25,
      "label": "mandarin",
      "text": "莫发贤呢，今年第一茬呢就种了十亩的黄瓜，",
      "score": 0.5962,
      "wav": "",
      "signals": {
        "mand_logprob": -0.5721,
        "sc_logprob": -0.6191,
        "sc_delta": -0.0469,
        "acoustic_dev": 1.0,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "魔法仙呢？今年第一茬呢，就种了十亩的黄瓜。"
      }
    },
    {
      "id": 7,
      "start": 30.25,
      "end": 34.177,
      "label": "mandarin",
      "text": "收入了十八万。本来应该继续种第二茬黄瓜的，",
