        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "拖拉机的南非在原来的荒地搞耕地，为春播水稻做好准备。"
      }
    },
    {
      "id": 6,
      "start": 25.576,
      "end": 28.065,
      "label": "mandarin",
      "text": "这边田那个以前是撂荒田，",
      "score": 0.2303,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3385,
        "sc_logprob": -0.3296,
        "sc_delta": 0.0089,
