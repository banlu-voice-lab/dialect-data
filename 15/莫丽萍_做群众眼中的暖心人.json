        "seg_cer": 0.182,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "引/硬 引/硬",
        "lexicon": "",
        "text_free": "记者见到莫丽萍的时候，她正在临桂区中庸镇东旺局岭村实地查看受强降雨影响村庄硬硬工程受灾情况。"
      }
    },
    {
