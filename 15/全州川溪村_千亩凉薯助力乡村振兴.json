        "sc_logprob": -0.9986,
        "sc_delta": 0.0127,
        "acoustic_dev": 1.0,
        "seg_cer": 0.379,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么这段时间呢，也是镇里面的传奇，称“千母良俗，陆陆续续上市”的时节了。"
      }
    },
    {
      "id": 6,
      "start": 20.399,
      "end": 25.348,
      "label": "mandarin",
      "text": "我记者去田间地头看到，感受到的呢是村民那种丰收的喜悦。",
