        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今年的八月，泉州天气持续的高温。"
      }
    },
    {
      "id": 8,
      "start": 28.662,
      "end": 31.973,
      "label": "mandarin",
      "text": "村民为了避开烈日的暴晒，保证产品的新鲜，",
