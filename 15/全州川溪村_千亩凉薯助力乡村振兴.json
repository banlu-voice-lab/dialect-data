        "sc_delta": -0.0069,
        "acoustic_dev": 0.0,
        "seg_cer": 0.04,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我们记者去田间地头看到，感受到的呢，是村民那种丰收的喜悦。"
      }
    },
    {
      "id": 7,
      "start": 25.649,
      "end": 28.662,
      "label": "guilin",
      "text": "今年的八月，全州天气持续的高温，",
