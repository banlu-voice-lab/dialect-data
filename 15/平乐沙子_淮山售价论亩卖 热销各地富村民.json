        "sc_logprob": -0.9518,
        "sc_delta": -0.0695,
        "acoustic_dev": 0.929,
        "seg_cer": 0.333,
        "lang_free": "Chinese",
        "phon_confuse": 0.2,
        "phon_examples": "初/促",
        "lexicon": "",
        "text_free": "也担负了一方的老百姓，促销的时间。"
      }
    },
    {
      "id": 8,
      "start": 25.256,
      "end": 28.699,
      "label": "mandarin",
      "text": "走进沙子镇平乐万亩翻山种植基地，",
