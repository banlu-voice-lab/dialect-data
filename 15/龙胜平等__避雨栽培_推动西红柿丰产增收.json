        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我们去到平等地的小乡村啊，一排排西红柿呢，就在碧玉棚里面整整齐齐地排列着。"
      }
    },
    {
      "id": 9,
      "start": 31.758,
