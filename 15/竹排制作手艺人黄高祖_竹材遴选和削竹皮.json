        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "精致的竹排是业余的奏法。"
      }
    },
    {
      "id": 9,
      "start": 34.422,
      "end": 36.778,
      "label": "mandarin",
      "text": "想要做一手专业的竹排，",
