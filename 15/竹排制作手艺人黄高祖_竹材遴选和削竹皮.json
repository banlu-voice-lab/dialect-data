        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "是啷子离不开这个主板的？那么今天呢？"
      }
    },
    {
      "id": 4,
      "start": 9.798,
      "end": 15.129,
      "label": "guilin",
      "text": "我就要向竹排的制作手艺人黄高柱去好好了解下子这个竹排，",
      "score": 0.1537,
