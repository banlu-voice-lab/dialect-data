        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "它到底是啷子奏出来的？"
      }
    },
    {
      "id": 6,
      "start": 23.311,
      "end": 27.638,
      "label": "guilin",
      "text": "平时我们看到的竹排都是七八根竹子捆绑而成的，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0144,
        "sc_logprob": -0.013,
