        "seg_cer": 0.059,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "是不是这么简单呢？方师傅告诉我们讲啊。"
      }
    },
    {
      "id": 8,
      "start": 31.26,
      "end": 33.976,
      "label": "guilin",
      "text": "真正的竹排是叶玉的竹法，",
