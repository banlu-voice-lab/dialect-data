        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "上回两伙问过一起，去了解当年丽江边渔民啊。"
      }
    },
    {
      "id": 3,
      "start": 6.494,
      "end": 9.798,
      "label": "mandarin",
      "text": "是啷子离不开这个竹排的。那么今天呢，",
      "score": 0.0571,
