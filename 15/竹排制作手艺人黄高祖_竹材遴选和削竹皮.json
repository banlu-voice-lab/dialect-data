        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "讲究那就多了。不，从选竹子开始，就要仔细遴选竹材。"
      }
    },
    {
      "id": 11,
      "start": 43.11,
      "end": 46.92,
      "label": "guilin",
      "text": "要选择毛竹，以十五年的冬竹为佳。",
