        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "平时我们看到的竹排，都是七八根竹子捆绑而成的。"
      }
    },
    {
      "id": 7,
      "start": 27.92,
      "end": 31.26,
      "label": "guilin",
      "text": "是不是这么简单呢？黄师傅告诉我们讲啊，",
