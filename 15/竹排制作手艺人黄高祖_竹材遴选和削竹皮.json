        "seg_cer": 0.154,
        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "子/之",
        "lexicon": "",
        "text_free": "我就要向竹排的制作手艺人方高主去好好了解之这个竹排。"
      }
    },
    {
      "id": 5,
      "start": 15.159,
      "end": 18.081,
      "label": "guilin",
      "text": "它到底是啷子造出来的。",
