        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "《黄帝内经》里头指出：“春夏养阳。”"
      }
    },
    {
      "id": 6,
      "start": 23.767,
      "end": 26.808,
      "label": "guilin",
      "text": "意思就是在春季和夏季的时候，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0039,
        "sc_logprob": -0.0038,
