        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "所谓阳气，就是大家平时讲的火力。"
      }
    },
    {
      "id": 9,
      "start": 34.232,
      "end": 37.182,
      "label": "mandarin",
      "text": "也就是人体新陈代谢的能力。",
      "score": 0.2131,
