        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "夏季养生可以从起居、饮食、情志三个方面着手。"
      }
    },
    {
      "id": 11,
      "start": 42.814,
      "end": 45.691,
      "label": "mandarin",
      "text": "从那个起居方面来讲的话，就是，",
