        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "人们应该注重对体内阳气的保养。"
      }
    },
    {
      "id": 8,
      "start": 30.286,
      "end": 33.987,
      "label": "mandarin",
      "text": "所谓阳气，就是大家平时讲的活力，",
      "score": 0.0327,
