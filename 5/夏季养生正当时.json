        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "人的阳气啊开始旺盛，新陈代谢也在增强。"
      }
    },
    {
      "id": 3,
      "start": 9.448,
      "end": 14.65,
      "label": "mandarin",
      "text": "虽然是极端天气，但是这段时间仍然是一个养生的好机会。",
