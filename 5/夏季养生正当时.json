      }
    },
    {
      "id": 7,
      "start": 26.949,
      "end": 29.908,
      "label": "mandarin",
      "text": "人们应该注重对体内阳气的保养。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0011,
        "sc_logprob": -0.0013,
        "sc_delta": -0.0002,
