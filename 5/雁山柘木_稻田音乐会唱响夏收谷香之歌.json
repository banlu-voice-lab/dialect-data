        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "唱响《下收满饭到故乡》之歌。"
      }
    },
    {
      "id": 3,
      "start": 10.75,
      "end": 24.904,
      "label": "guilin",
      "text": "浪漫的很。此次乡间音乐会吸引了广大市民和游客前来观赏，",
      "score": 0.0835,
      "wav": "",
      "signals": {
        "mand_logprob": -0.078,
        "sc_logprob": -0.0724,
        "sc_delta": 0.0057,
        "acoustic_dev": 0.02,
        "seg_cer": 0.16,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "浪漫得很。此次《相见音乐飞》吸引了广大市民和游客前来观赏。"
      }
    },
    {
      "id": 4,
      "start": 25.088,
      "end": 28.864,
      "label": "guilin",
      "text": "体验在稻田间享受音乐的独特氛围。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0012,
        "sc_logprob": -0.0011,
        "sc_delta": 0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "体验在稻田间享受音乐的独特氛围。"
      }
    },
    {
      "id": 5,
      "start": 29.106,
      "end": 31.669,
      "label": "guilin",
      "text": "音乐会以泽木为题材，",
      "score": 0.6216,
      "wav": "",
      "signals": {
        "mand_logprob": -1.1681,
        "sc_logprob": -0.9327,
        "sc_delta": 0.2354,
        "acoustic_dev": 1.0,
        "seg_cer": 0.222,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "音乐会则以《泽母》为题材。"
      }
    },
    {
      "id": 6,
      "start": 31.812,
      "end": 37.196,
      "label": "mandarin",
      "text": "以乡村振兴为背景的原创歌曲《泽啊泽中》拉开了序幕。",
      "score": 0.1416,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0087,
        "sc_logprob": -0.0112,
        "sc_delta": -0.0025,
        "acoustic_dev": 0.0,
        "seg_cer": 0.091,
        "lang_free": "Chinese",
        "phon_confuse": 1.0,
        "phon_examples": "泽/这 泽/这",
        "lexicon": "",
        "text_free": "以乡村振兴为背景的原创歌曲《这啊这》中拉开了序幕。"
      }
    },
    {
      "id": 7,
      "start": 37.621,
      "end": 41.798,
      "label": "mandarin",
      "text": "在希望的田野上，等一首首脍炙人口的歌曲，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0011,
        "sc_logprob": -0.0011,
        "sc_delta": -0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在希望的田野上，等一首首脍炙人口的歌曲。"
      }
    },
    {
      "id": 8,
      "start": 41.973,
      "end": 46.423,
      "label": "guilin",
      "text": "如同山间清泉，为音乐会增添了一抹温馨，",
      "score": 0.1807,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0475,
