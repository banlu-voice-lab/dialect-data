        "phon_examples": "清/亲 山/三",
        "lexicon": "",
        "text_free": "如同三间亲眷为音乐会增添了一抹温馨。"
      }
    },
    {
      "id": 9,
      "start": 46.667,
      "end": 49.271,
      "label": "guilin",
      "text": "唱响了乡村振兴的希望。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.019,
        "sc_logprob": -0.0154,
