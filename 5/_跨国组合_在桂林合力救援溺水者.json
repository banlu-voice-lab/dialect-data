        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "南/兰",
        "lexicon": "",
        "text_free": "督导队员何军燕当时和新西兰老人艾伦一起参与救援。"
      }
    },
    {
      "id": 9,
