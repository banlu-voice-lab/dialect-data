        "lang_free": "Chinese",
        "phon_confuse": 0.2,
        "phon_examples": "南/兰",
        "lexicon": "",
        "text_free": "一名来自新西兰的老人，艾伦，和五桂林市民一起。"
      }
    },
    {
      "id": 3,
      "start": 12.244,
      "end": 17.811,
      "label": "mandarin",
      "text": "在这两天的时间里头，成功将五名溺水者救援上岸。",
