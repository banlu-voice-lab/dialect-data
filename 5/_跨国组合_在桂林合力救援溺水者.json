      }
    },
    {
      "id": 6,
      "start": 26.285,
      "end": 32.405,
      "label": "guilin",
      "text": "夜间下水到漓江戏水是众多桂林市民偏爱的消暑方式之一。",
      "score": 0.1762,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1258,
        "sc_logprob": -0.125,
        "sc_delta": 0.0008,
        "acoustic_dev": 0.128,
        "seg_cer": 0.24,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "沿沿下邑到漓江西水，是众多桂林市民偏爱的下厨方式之一。"
      }
    },
    {
      "id": 7,
      "start": 32.725,
      "end": 45.219,
      "label": "mandarin",
      "text": "为了防止发生溺水事故，市东永协会义务督导队每天傍晚在游泳高峰期都会到漓江边的一些重点水域开展义务巡逻值守。",
      "score": 0.0179,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0051,
        "sc_logprob": -0.0061,
        "sc_delta": -0.001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.039,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "为了防止发生溺水事故，市东涌协会义务督导队每天傍晚在游泳高峰期都会到丽江边的一些重点水域开展义务巡逻值守。"
      }
    },
    {
