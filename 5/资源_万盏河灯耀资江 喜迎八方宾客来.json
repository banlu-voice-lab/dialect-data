        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "旅游旺季，老们当然要车子旅游的半路。每年中元节。"
      }
    },
    {
      "id": 2,
      "start": 5.257,
      "end": 7.74,
      "label": "mandarin",
      "text": "资源县就会举办活动过节。",
