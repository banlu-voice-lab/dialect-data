        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "对，昨天晚上十点多钟，十一点钟泡起。"
      }
    },
    {
      "id": 35,
      "start": 151.246,
      "end": 153.667,
      "label": "guilin",
      "text": "你要把那个灶烧开，",
