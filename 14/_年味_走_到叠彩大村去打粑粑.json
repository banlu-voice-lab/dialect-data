        "seg_cer": 0.062,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "马上就要过年了，恁家有什么传统项目或者是传统美食，是过年一定要做的呢？"
      }
    },
    {
      "id": 17,
      "start": 72.843,
      "end": 80.002,
      "label": "mandarin",
      "text": "是要炸米花、炸呃玉兰片、炸泡油嘞，还是要蒸年糕、蒸糯米、打粑粑嘞？",
