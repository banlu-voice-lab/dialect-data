        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "猪的全身都是宝。"
      }
    },
    {
      "id": 6,
      "start": 17.757,
      "end": 20.22,
      "label": "mandarin",
      "text": "连猪的名字都有用，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.001,
        "sc_logprob": -0.0017,
        "sc_delta": -0.0007,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "连猪的名字都有用。"
      }
    },
    {
      "id": 7,
      "start": 20.22,
      "end": 23.278,
      "label": "mandarin",
      "text": "用来骂人。拿点没和你开个玩笑啊！",
      "score": 0.1406,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3332,
