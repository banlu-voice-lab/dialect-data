        "seg_cer": 0.083,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "是特别有意义。老话不是讲了嘛。"
      }
    },
    {
      "id": 5,
      "start": 15.59,
      "end": 17.757,
      "label": "mandarin",
      "text": "猪的全身都是宝，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0465,
        "sc_logprob": -0.0461,
        "sc_delta": 0.0004,
