        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今天用技术去农村走一走。"
      }
    },
    {
      "id": 14,
      "start": 49.175,
      "end": 54.901,
      "label": "mandarin",
      "text": "体验一下那里的年味，看着他们春节前又会做点什么好吃的东西。",
      "score": 0.2069,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0592,
