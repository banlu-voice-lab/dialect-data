        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "相传这一天啊，女娲娘娘创造出了猪。"
      }
    },
    {
      "id": 3,
      "start": 8.221,
      "end": 12.938,
      "label": "guilin",
      "text": "猪是一种憨厚、萌宠的动物，而且带有“阴”嘞，",
      "score": 0.4701,
      "wav": "",
      "signals": {
        "mand_logprob": -1.0627,
        "sc_logprob": -1.009,
        "sc_delta": 0.0537,
        "acoustic_dev": 0.492,
        "seg_cer": 0.294,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞 咧",
        "text_free": "猪是一种憨厚、萌宠的动物，而且得用人类咧。"
      }
    },
    {
      "id": 4,
      "start": 12.938,
      "end": 15.59,
      "label": "mandarin",
      "text": "是特别有意。老话不是讲了嘛，",
      "score": 0.0381,
