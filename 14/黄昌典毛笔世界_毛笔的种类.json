        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "支/子",
        "lexicon": "",
        "text_free": "但是，一杆毛笔到底是啷子制作出来的？"
      }
    },
    {
      "id": 6,
      "start": 20.272,
      "end": 23.5,
      "label": "mandarin",
      "text": "相信晓得的人是少之又少。",
