        "seg_cer": 0.455,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一般指的是洋号币，N号呢？"
      }
    },
    {
      "id": 11,
      "start": 54.059,
      "end": 56.899,
      "label": "guilin",
      "text": "常见的就有紫毫、狼毫、",
