        "phon_examples": "狼/蓝",
        "lexicon": "",
        "text_free": "常见的就有紫号、蓝号。"
      }
    },
    {
      "id": 12,
      "start": 56.899,
      "end": 59.903,
      "label": "mandarin",
      "text": "石獾毫等等。至于兼毫呢，",
