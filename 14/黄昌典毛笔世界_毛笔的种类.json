        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "拥有啊，上百年的历史了。在老一辈的桂林里面呢。"
      }
    },
    {
      "id": 4,
      "start": 12.456,
      "end": 16.475,
      "label": "mandarin",
      "text": "哎名气不小的不。毛笔啊，蛮多人都用过，",
