        "seg_cer": 0.062,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "哎，名气不小的不？毛笔啊，很多人都用过。"
      }
    },
    {
      "id": 5,
      "start": 16.486,
      "end": 20.187,
      "label": "mandarin",
      "text": "但是，一杆毛笔到底是哪支制作出来的，",
