        "seg_cer": 0.692,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "简好比三大类，远好呢？"
      }
    },
    {
      "id": 10,
      "start": 51.42,
      "end": 54.059,
      "label": "mandarin",
      "text": "一般指的是羊毫笔。硬毫呢，",
