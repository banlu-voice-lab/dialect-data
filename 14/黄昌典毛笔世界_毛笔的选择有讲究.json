      }
    },
    {
      "id": 17,
      "start": 73.483,
      "end": 75.84,
      "label": "mandarin",
      "text": "毛头不能松动，也不能太紧，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0005,
        "sc_logprob": -0.0006,
        "sc_delta": -0.0,
