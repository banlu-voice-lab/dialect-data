        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "嗯，我们进行首先要把它配好。"
      }
    },
    {
      "id": 15,
      "start": 67.191,
      "end": 70.053,
      "label": "mandarin",
      "text": "啊，要先配起先，因为大小不一样。",
