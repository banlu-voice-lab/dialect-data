        "lang_free": "Cantonese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "哦，對，我們就將把左後嘅鼻頭。"
      }
    },
    {
      "id": 14,
      "start": 64.08,
      "end": 67.191,
      "label": "mandarin",
      "text": "嗯，我们进行首先要把它配好。",
