        "seg_cer": 0.625,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "是不是认真理解一下？我从哪里走过来的时候。"
      }
    },
    {
      "id": 73,
      "start": 309.303,
      "end": 311.475,
      "label": "guilin",
      "text": "进去了，进去了，",
