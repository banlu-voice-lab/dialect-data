        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "村民们都喊他“下马台”。"
      }
    },
    {
      "id": 67,
      "start": 287.778,
      "end": 291.481,
      "label": "mandarin",
      "text": "这个这个是什么台子？下马台。八八国形状的。",
      "score": 0.1016,
