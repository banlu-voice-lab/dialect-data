        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "房地产弄的物管啊，他要请มา过来。"
      }
    },
    {
      "id": 70,
      "start": 297.352,
      "end": 303.482,
      "label": "mandarin",
      "text": "都是下马的。嗯，他里面那院了马好高啊，你不会去拿人啥子嘛？",
      "score": 0.2121,
      "wav": "",
      "signals": {
        "mand_logprob": -0.7289,
