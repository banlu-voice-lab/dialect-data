        "sc_logprob": -2.6196,
        "sc_delta": 0.0191,
        "acoustic_dev": 0.832,
        "seg_cer": 0.625,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "哪个 晓得",
        "text_free": "他就直接，哎呀，要要要！他说：“想那个找那个叫什么。”"
      }
    },
    {
      "id": 45,
      "start": 199.354,
      "end": 202.423,
      "label": "guilin",
      "text": "要那个兵带回来那个那个警察",
