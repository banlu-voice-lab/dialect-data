        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "根据《临桂县志》记载。"
      }
    },
    {
      "id": 3,
      "start": 7.285,
      "end": 10.182,
      "label": "mandarin",
      "text": "衡山村有座深厚的文化底蕴。",
      "score": 0.1593,
      "wav": "",
      "signals": {
        "mand_logprob": -0.8843,
        "sc_logprob": -0.9008,
        "sc_delta": -0.0165,
        "acoustic_dev": 0.16,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "衡山城有着深厚的文化底蕴。"
      }
    },
    {
      "id": 4,
      "start": 10.419,
      "end": 14.113,
      "label": "mandarin",
      "text": "清代中期，衡山村达到了全盛时期，",
      "score": 0.2433,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0235,
        "sc_logprob": -0.0238,
        "sc_delta": -0.0003,
        "acoustic_dev": 0.0,
        "seg_cer": 0.643,
        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "时/四 山/三 中/总",
        "lexicon": "",
        "text_free": "青岛总气衡三称达到了全省四气。"
      }
    },
    {
      "id": 5,
      "start": 14.308,
      "end": 18.668,
      "label": "mandarin",
      "text": "当时村里头啊有两百多户，一共有两三千人。",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0007,
        "sc_logprob": -0.0007,
        "sc_delta": -0.0,
        "acoustic_dev": 0.0,
        "seg_cer": 0.056,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "当时城里头啊，有两百多户，一共有两三千人。"
      }
    },
    {
      "id": 6,
      "start": 19.005,
      "end": 22.278,
      "label": "mandarin",
      "text": "陈氏家族屡有科考高中者，",
      "score": 0.21,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3749,
        "sc_logprob": -0.3889,
        "sc_delta": -0.014,
        "acoustic_dev": 0.0,
        "seg_cer": 0.455,
        "lang_free": "Chinese",
        "phon_confuse": 0.2,
        "phon_examples": "陈/城",
        "lexicon": "",
        "text_free": "城市家族旅游，可考高中者。"
      }
    },
    {
      "id": 7,
      "start": 22.331,
      "end": 27.322,
      "label": "mandarin",
      "text": "陈氏一族在历史上创造了不少宝贵的人文遗产，",
      "score": 0.1914,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1713,
        "sc_logprob": -0.1818,
        "sc_delta": -0.0105,
        "acoustic_dev": 0.0,
        "seg_cer": 0.2,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "族/著 陈/城",
        "lexicon": "",
        "text_free": "城市遗著在历史上创造了不少宝贵的人文遗产。"
      }
    },
    {
      "id": 8,
      "start": 27.471,
      "end": 31.201,
      "label": "mandarin",
      "text": "比如石刻、墓碑等等人文景观。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0032,
        "sc_logprob": -0.0035,
        "sc_delta": -0.0003,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "比如石刻、墓碑等等人文景观。"
      }
    },
    {
      "id": 9,
      "start": 32.307,
      "end": 39.409,
      "label": "mandarin",
      "text": "衡山村有关陈氏的石刻主要分布在陈氏宗祠以及宗祠后面的山上。",
      "score": 0.26,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0323,
        "sc_logprob": -0.0341,
        "sc_delta": -0.0018,
        "acoustic_dev": 0.0,
        "seg_cer": 0.357,
        "lang_free": "Chinese",
        "phon_confuse": 0.4,
        "phon_examples": "祠/池 宗/冢 祠/池 宗/冢",
        "lexicon": "",
        "text_free": "横山称，有关沉尸的石刻主要分布在沉尸冢池以及冢池后面的山上。"
      }
    },
    {
      "id": 10,
      "start": 40.9,
      "end": 47.137,
      "label": "mandarin",
      "text": "这个山怎么讲？风风都是山风的风，风山的土名字是我们村的土名字。",
      "score": 0.16,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4024,
        "sc_logprob": -0.4286,
        "sc_delta": -0.0262,
        "acoustic_dev": 0.0,
        "seg_cer": 0.464,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这个山还是没山。风风就是山风的风，风山是透明，就是我们称的透明。"
      }
    },
    {
      "id": 11,
      "start": 47.666,
      "end": 52.567,
      "label": "mandarin",
      "text": "以前呢，乾隆皇帝封他一个号的，有个一品风。",
      "score": 0.2,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0835,
        "sc_logprob": -0.0867,
        "sc_delta": -0.0032,
        "acoustic_dev": 0.0,
        "seg_cer": 0.5,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "以前咧，都钱龙房，你要封他一个号的呀，有个一品房。"
      }
    },
    {
      "id": 12,
      "start": 53.4,
      "end": 55.933,
      "label": "guilin",
      "text": "啊，这个山一户在讲的，",
      "score": 0.7157,
      "wav": "",
      "signals": {
        "mand_logprob": -3.6532,
        "sc_logprob": -3.5616,
        "sc_delta": 0.0916,
        "acoustic_dev": 1.0,
        "seg_cer": 0.778,
        "lang_free": "Chinese",
        "phon_confuse": 0.143,
        "phon_examples": "山/三",
        "lexicon": "",
        "text_free": "啊，我我三也不得了的。"
      }
    },
    {
      "id": 13,
      "start": 56.5,
      "end": 59.0,
      "label": "mandarin",
      "text": "跟我对着我们那个宗祠啊，",
      "score": 0.531,
      "wav": "",
      "signals": {
        "mand_logprob": -1.9118,
        "sc_logprob": -2.0097,
        "sc_delta": -0.098,
