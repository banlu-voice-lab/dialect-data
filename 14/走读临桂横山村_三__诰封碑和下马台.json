        "lang_free": "Chinese",
        "phon_confuse": 0.125,
        "phon_examples": "祠/翅",
        "lexicon": "",
        "text_free": "我这个虾啊，都是金翅的。"
      }
    },
    {
      "id": 72,
      "start": 305.79,
      "end": 309.303,
      "label": "guilin",
      "text": "是不是？你别讲，我从那边走过来的，下好。",
