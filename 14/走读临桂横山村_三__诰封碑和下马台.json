        "seg_cer": 0.818,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "他过年啊，对，就每那次的。"
      }
    },
    {
      "id": 69,
      "start": 294.673,
      "end": 297.352,
      "label": "guilin",
      "text": "放点那那五光啊，还有青瓦过来，",
      "score": 0.4062,
