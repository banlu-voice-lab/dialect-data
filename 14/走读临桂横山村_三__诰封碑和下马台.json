        "seg_cer": 0.222,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这个这个是个什么台子？虾马台，八八国行长的。"
      }
    },
    {
      "id": 68,
      "start": 291.481,
      "end": 293.783,
      "label": "guilin",
      "text": "八国的啊。对，里面的好老五",
      "score": 0.68,
      "wav": "",
      "signals": {
        "mand_logprob": -3.3244,
        "sc_logprob": -3.3079,
