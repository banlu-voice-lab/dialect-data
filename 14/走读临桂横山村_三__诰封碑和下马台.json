        "seg_cer": 0.357,
        "lang_free": "Chinese",
        "phon_confuse": 0.2,
        "phon_examples": "石/四",
        "lexicon": "",
        "text_free": "总之，六里四刻碑文，我们暂且不提。"
      }
    },
    {
      "id": 16,
      "start": 68.696,
      "end": 72.921,
      "label": "mandarin",
      "text": "在进陈氏宗祠之前，我们就看到有两块碑，",
