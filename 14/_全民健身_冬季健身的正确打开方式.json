        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我这口啊，有一份运动指南。"
      }
    },
    {
      "id": 4,
      "start": 9.781,
      "end": 13.811,
      "label": "mandarin",
      "text": "哎，大家拿走不谢。做好充分准备，",
      "score": 0.5903,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4743,
