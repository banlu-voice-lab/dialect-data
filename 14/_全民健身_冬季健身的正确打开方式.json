    {
      "id": 3,
      "start": 7.113,
      "end": 9.781,
      "label": "guilin",
      "text": "我这开啊有一份运动指南，",
      "score": 0.5616,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4709,
        "sc_logprob": -0.4516,
        "sc_delta": 0.0193,
