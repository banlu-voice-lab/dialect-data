        "lexicon": "",
        "text_free": "不要太过劳累，积极锻炼身体。"
      }
    },
    {
      "id": 7,
      "start": 22.48,
      "end": 25.945,
      "label": "mandarin",
      "text": "运动以后注意补水，保持膳食均衡，",
      "score": 0.6853,
      "wav": "",
