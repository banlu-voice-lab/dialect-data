    {
      "id": 4,
      "start": 10.764,
      "end": 14.574,
      "label": "mandarin",
      "text": "我们一起来了解一下如何预防感冒。",
      "score": 0.0139,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0258,
        "sc_logprob": -0.03,
