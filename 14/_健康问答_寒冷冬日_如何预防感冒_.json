    {
      "id": 5,
      "start": 15.015,
      "end": 19.376,
      "label": "mandarin",
      "text": "首先，注意保暖，增强局部御寒能力和抵抗力，",
      "score": 0.0254,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0084,
        "sc_logprob": -0.021,
        "sc_delta": -0.0125,
        "acoustic_dev": 0.0,
        "seg_cer": 0.056,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "首先，注意保暖，增强局部御寒能力或抵抗力。"
      }
    },
    {
      "id": 6,
      "start": 19.588,
      "end": 22.313,
      "label": "mandarin",
      "text": "不要太过劳累，积极锻炼身体。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0009,
        "sc_logprob": -0.0007,
        "sc_delta": 0.0001,
