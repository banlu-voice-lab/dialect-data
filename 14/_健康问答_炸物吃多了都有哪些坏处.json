        "seg_cer": 0.059,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一油炸的东西，吃得越多，心脏病风险越大。"
      }
    },
    {
