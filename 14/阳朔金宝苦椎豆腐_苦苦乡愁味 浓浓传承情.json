        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "喊作“苦醉豆腐”。苦醉豆腐呢，是当地人啊，通过自己的勤劳和智慧。"
      }
    },
    {
      "id": 3,
      "start": 9.757,
