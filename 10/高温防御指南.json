    {
      "id": 5,
      "start": 16.716,
      "end": 21.184,
      "label": "mandarin",
      "text": "高温呢是指最高气温达到了三十五摄氏度以上的天气现象。",
      "score": 0.0549,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0075,
        "sc_logprob": -0.0075,
        "sc_delta": 0.0,
        "acoustic_dev": 0.0,
        "seg_cer": 0.12,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "高温呐，是指最高气温达到了三十五、四十度以上的天气现象。"
      }
    },
    {
      "id": 6,
      "start": 21.324,
      "end": 24.487,
      "label": "mandarin",
      "text": "持续高温天气呢会给人呢感觉到不舒服，",
      "score": 0.4081,
      "wav": "",
