        "seg_cer": 0.118,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "持/此",
        "lexicon": "",
        "text_free": "此处高温天气呢，会给人呢感觉到不舒服。"
      }
    },
    {
      "id": 7,
      "start": 24.487,
      "end": 26.619,
      "label": "mandarin",
      "text": "工作效率降低，疾病频发，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0141,
        "sc_logprob": -0.0125,
