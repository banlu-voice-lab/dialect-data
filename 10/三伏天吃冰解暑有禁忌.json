  "segments": [
    {
      "id": 1,
      "start": 0.0,
      "end": 5.291,
      "label": "mandarin",
      "text": "天气热了，三伏天也来了，大家呢都喜欢个吃点冰棒啊，喝点冰水。",
      "score": 0.0527,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0021,
        "sc_logprob": -0.0019,
        "sc_delta": 0.0002,
        "acoustic_dev": 0.0,
        "seg_cer": 0.115,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "天气夜了，散步天也来了。大家呢，都喜欢个吃点冰棒啊，喝点冰水。"
      }
    },
    {
      "id": 2,
      "start": 5.291,
      "end": 7.857,
      "label": "mandarin",
      "text": "这些冷饮啊是可以吃点的，但是呢，",
      "score": 0.0327,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0377,
        "sc_logprob": -0.0363,
        "sc_delta": 0.0013,
        "acoustic_dev": 0.0,
        "seg_cer": 0.071,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这些冷饮啊是可以吃的点的，但是呢。"
      }
    },
    {
      "id": 3,
      "start": 7.857,
      "end": 12.024,
      "label": "mandarin",
      "text": "千万莫吃多。而且吃冷饮的有些糖尿病患者，",
      "score": 0.2984,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1253,
        "sc_logprob": -0.1391,
        "sc_delta": -0.0139,
        "acoustic_dev": 0.35,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "千万莫吃多，而且吃了你嘞，有些糖尿病患者。"
      }
    },
    {
      "id": 4,
      "start": 12.024,
      "end": 14.903,
      "label": "mandarin",
      "text": "或者是长胖的，还有老年人和小朋友，",
      "score": 0.161,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0176,
        "sc_logprob": -0.0165,
        "sc_delta": 0.0011,
        "acoustic_dev": 0.0,
        "seg_cer": 0.133,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "长/站",
        "lexicon": "",
        "text_free": "或者是站旁的，还有老年人和小朋友。"
      }
    },
    {
      "id": 5,
      "start": 14.903,
      "end": 18.3,
      "label": "mandarin",
      "text": "这些人群啊，尤其要注意在吃冷饮方面呢，",
      "score": 0.2698,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0935,
        "sc_logprob": -0.0995,
        "sc_delta": -0.0061,
        "acoustic_dev": 0.223,
        "seg_cer": 0.118,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "吃/次",
        "lexicon": "",
        "text_free": "这些人群啊，尤其要注意这次冷饮方面呢。"
      }
    },
    {
      "id": 6,
      "start": 18.3,
      "end": 21.717,
      "label": "mandarin",
      "text": "一定要记到，免得呢影响自己的身体健康。",
      "score": 0.0669,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0187,
        "sc_logprob": -0.0221,
        "sc_delta": -0.0034,
        "acoustic_dev": 0.0,
        "seg_cer": 0.059,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "一定要记到，免得嘞影响自己的身体健康。"
      }
    },
    {
      "id": 7,
      "start": 22.273,
      "end": 26.792,
      "label": "mandarin",
      "text": "糖尿病患者和肥胖人群，由于冷饮含糖量比较高，",
      "score": 0.0229,
      "wav": "",
      "signals": {
        "mand_logprob": -0.006,
        "sc_logprob": -0.0068,
        "sc_delta": -0.0008,
        "acoustic_dev": 0.0,
        "seg_cer": 0.05,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "糖尿病患者或肥胖人群，由于冷饮含糖量比较高。"
      }
    },
    {
      "id": 8,
      "start": 26.792,
      "end": 30.005,
      "label": "mandarin",
      "text": "糖尿病患者吃了之后呢，就会导致血糖升高，",
      "score": 0.0897,
      "wav": "",
