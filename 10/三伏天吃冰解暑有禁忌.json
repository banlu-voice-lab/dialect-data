        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "咧",
        "text_free": "加重病情。如果胖龄吃多冷饮咧。"
      }
    },
    {
      "id": 10,
      "start": 32.738,
      "end": 36.412,
      "label": "mandarin",
      "text": "会更加的胖，而且容易诱发脂肪肝。",
