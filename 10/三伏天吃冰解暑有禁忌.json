        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "糖尿病患者吃了肉呢，就会导致血糖升高。"
      }
    },
    {
      "id": 9,
      "start": 30.005,
      "end": 32.738,
      "label": "mandarin",
      "text": "加重病情。如果胖人吃多冷饮呢，",
      "score": 0.265,
      "wav": "",
