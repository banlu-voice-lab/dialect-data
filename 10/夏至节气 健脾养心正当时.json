    {
      "id": 1,
      "start": 0.0,
      "end": 3.26,
      "label": "mandarin",
      "text": "现在啊，最热的时间段来了不？",
      "score": 0.6628,
      "wav": "",
      "signals": {
        "mand_logprob": -0.6174,
        "sc_logprob": -0.6582,
        "sc_delta": -0.0409,
