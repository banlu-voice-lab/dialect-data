        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "好多人啊，吹了空调之后，哎。"
      }
    },
    {
      "id": 3,
      "start": 6.12,
      "end": 12.051,
      "label": "mandarin",
      "text": "又是头昏啦，鼻子又堵气喘不得气啦，甚至是还有关节酸痛的症状，",
