        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "以预防冬季旧病的复发，或者感情上的症状。"
      }
    },
    {
      "id": 8,
      "start": 42.133,
      "end": 46.775,
      "label": "mandarin",
      "text": "防病治病的一个方法。为什么冬病能夏治？",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0104,
