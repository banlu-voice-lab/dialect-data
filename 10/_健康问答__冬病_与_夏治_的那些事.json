      "wav": "",
      "signals": {
        "mand_logprob": -0.0014,
        "sc_logprob": -0.0019,
        "sc_delta": -0.0005,
        "acoustic_dev": 0.0,
        "seg_cer": 0.056,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "冻病的发生和人体阳气不足有密切的关系。"
      }
    },
    {
      "id": 10,
      "start": 51.173,
      "end": 53.74,
      "label": "mandarin",
      "text": "由于患者体内的阳气不足，",
      "score": 0.0416,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0006,
        "sc_logprob": -0.0006,
