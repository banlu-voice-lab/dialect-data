      }
    },
    {
      "id": 4,
      "start": 15.223,
      "end": 22.313,
      "label": "mandarin",
      "text": "我们就要看着。冬病啊，指的是好发于冬季或者冬季加重的虚寒性的疾病，",
      "score": 0.1772,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1438,
        "sc_logprob": -0.1427,
        "sc_delta": 0.001,
        "acoustic_dev": 0.194,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我需要看的。冻病啊，指的是好发于冬季或者在冬季加重的虚寒性的疾病。"
      }
    },
    {
      "id": 5,
      "start": 22.403,
      "end": 27.778,
      "label": "mandarin",
      "text": "包括了咳嗽、哮喘、过敏性鼻炎等等这些慢性的疾患。",
      "score": 0.0218,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0026,
        "sc_logprob": -0.0024,
        "sc_delta": 0.0002,
        "acoustic_dev": 0.0,
        "seg_cer": 0.048,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "包括了咳嗽、哮喘、过敏性鼻炎等等，这一些慢性的疾患。"
      }
    },
    {
      "id": 6,
      "start": 28.137,
      "end": 37.366,
      "label": "mandarin",
      "text": "夏治呢，指的是夏天炎热的时候，主要讲的是三伏天十大类内服中药并且结合三伏贴这一方法，",
      "score": 0.2026,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1394,
        "sc_logprob": -0.1492,
        "sc_delta": -0.0098,
        "acoustic_dev": 0.187,
        "seg_cer": 0.231,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "夏治呢，指的是夏天炎热的时候，主要讲的是散服贴，适当的内服中药，并且结合散服贴这些方法。"
      }
    },
    {
      "id": 7,
      "start": 37.513,
      "end": 42.133,
      "label": "mandarin",
      "text": "以预防冬季旧病的复发或者减轻它的症状，",
      "score": 0.5962,
