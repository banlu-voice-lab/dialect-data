        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "由于患者体内的氧气不足。"
      }
    },
    {
      "id": 11,
      "start": 53.74,
      "end": 57.761,
      "label": "mandarin",
      "text": "加上冬季呢更容易受到寒湿之邪的侵袭，",
