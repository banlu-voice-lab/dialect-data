        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么，这个三伏贴有什么功效？或者讲什么叫做冬病夏治。"
      }
    },
    {
      "id": 3,
      "start": 12.684,
      "end": 15.223,
