        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "防病治病的一个方法。为什么冬病能夏治？"
      }
    },
    {
      "id": 9,
      "start": 46.775,
      "end": 51.038,
      "label": "mandarin",
      "text": "冬病的发生和人体阳气不足有密切的关系。",
