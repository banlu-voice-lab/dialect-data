        "seg_cer": 0.143,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "香碧山位于漓江和桃花江汇流处。"
      }
    },
    {
      "id": 3,
      "start": 15.552,
      "end": 20.043,
      "label": "mandarin",
      "text": "因为山体呢就像一只正在江边喝水的大象而得名的。",
