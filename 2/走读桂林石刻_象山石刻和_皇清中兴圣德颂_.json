        "seg_cer": 0.237,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "好的，继续我们的走读桂林时刻的版路。这一站我们要去到香山公园，走访一下香碧山摩崖石刻。"
      }
    },
    {
      "id": 2,
      "start": 11.004,
      "end": 15.21,
      "label": "mandarin",
      "text": "象鼻山位于漓江和桃花江汇流处，",
