      }
    },
    {
      "id": 5,
      "start": 29.356,
      "end": 36.909,
      "label": "mandarin",
      "text": "二零二二年六月二十七号下午，正在资源县滨江长廊散步的五十一岁建筑工人杨振良，",
      "score": 0.1133,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0028,
        "acoustic_dev": 0.0,
        "seg_cer": 0.111,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "振/正",
        "lexicon": "",
        "text_free": "二零二二年六月二十七号下午，正在紫阳县滨江长廊散步的五十一岁建筑工营杨正良。"
      }
    },
    {
      "id": 6,
      "start": 37.149,
      "end": 39.669,
      "label": "mandarin",
      "text": "突然间听到救命的呼喊声，",
      "score": 0.0,
