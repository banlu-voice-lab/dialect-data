        "seg_cer": 0.05,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "他马上循声奔去，就看到三个学生在河水里头挣扎。"
      }
    },
    {
      "id": 8,
      "start": 44.875,
      "end": 47.803,
      "label": "guilin",
      "text": "其中一位勉强靠近岸边呼救，",
