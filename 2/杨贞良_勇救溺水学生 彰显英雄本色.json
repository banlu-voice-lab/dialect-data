        "phon_confuse": 1.0,
        "phon_examples": "纵/终",
        "lexicon": "",
        "text_free": "这位年过半百的汉子，用三次终身入水的壮举。"
      }
    },
    {
      "id": 4,
      "start": 25.053,
      "end": 29.18,
      "label": "mandarin",
      "text": "在珠江激流当中谱写了一曲生命赞歌。",
      "score": 0.0913,
      "wav": "",
      "signals": {
        "mand_logprob": -0.074,
