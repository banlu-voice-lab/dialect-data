      "signals": {
        "mand_logprob": -0.0208,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "突然间听到救命的呼喊声。"
      }
    },
    {
      "id": 7,
      "start": 39.916,
      "end": 44.619,
      "label": "mandarin",
      "text": "他马上循声奔去，就看到三个学生在河水里挣扎，",
      "score": 0.0229,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0054,
