      "signals": {
        "mand_logprob": -0.0982,
        "acoustic_dev": 0.026,
        "seg_cer": 0.105,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在种植的过程当中，唐坚持以物理防治为主。"
      }
    },
    {
      "id": 14,
      "start": 63.241,
      "end": 67.757,
      "label": "mandarin",
      "text": "辅以人工管护，确保水蜜桃保持原生态品质。",
      "score": 0.1641,
