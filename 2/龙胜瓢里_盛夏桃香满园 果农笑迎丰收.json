        "mand_logprob": -0.933,
        "acoustic_dev": 0.705,
        "seg_cer": 0.25,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "记者在朴里城的桃园里，又看到。"
      }
    },
    {
      "id": 4,
      "start": 18.061,
      "end": 20.581,
      "label": "mandarin",
      "text": "一颗颗饱满的果实挂满枝头，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0119,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "一颗颗饱满的果实挂满枝头。"
      }
    },
    {
      "id": 5,
      "start": 20.92,
      "end": 26.05,
      "label": "mandarin",
      "text": "果农潘燕娥和丈夫正在熟练地采摘着成熟的桃子，",
      "score": 0.1723,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0535,
        "acoustic_dev": 0.0,
        "seg_cer": 0.286,
        "lang_free": "Chinese",
        "phon_confuse": 0.167,
        "phon_examples": "农/龙",
        "lexicon": "",
        "text_free": "郭龙、潘燕、我和丈夫正在树林里采摘着成熟的桃子。"
      }
    },
    {
      "id": 6,
      "start": 26.21,
      "end": 33.02,
      "label": "mandarin",
      "text": "准备打包发往外地。今朝都有两个老来子，已经这个六十多斤、",
      "score": 0.1097,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0574,
        "acoustic_dev": 0.0,
        "seg_cer": 0.24,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "准备打包法王麦迪。今早都有两个老赖子，已经这个六十多斤。"
      }
    },
    {
      "id": 7,
      "start": 33.02,
      "end": 35.583,
      "label": "guilin",
      "text": "一百斤在多，两水蜜桃，",
