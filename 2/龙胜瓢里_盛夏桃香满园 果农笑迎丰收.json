    {
      "id": 12,
      "start": 49.823,
      "end": 58.442,
      "label": "mandarin",
      "text": "他们的果园四季飘香。凭借着多年的种植经验，潘燕娥夫妇摸索出了一套独特的种植方法。",
      "score": 0.0371,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0082,
        "acoustic_dev": 0.0,
        "seg_cer": 0.081,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "塘里果园四季飘香。凭借着多年的种植经验，潘燕娥夫妇摸索出了一套独特的种植方法。"
      }
    },
    {
      "id": 13,
      "start": 58.768,
      "end": 63.013,
      "label": "mandarin",
      "text": "在种植的过程当中，他们坚持以物理防治为主，",
      "score": 0.0617,
