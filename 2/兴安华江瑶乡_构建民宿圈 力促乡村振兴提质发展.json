        "seg_cer": 0.104,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "这几年，兴安县花江瑶族乡依托良好的自然生态，持续打造花江酒寨，使民宿产业成为了乡村发展的新赛道和新热点。"
      }
