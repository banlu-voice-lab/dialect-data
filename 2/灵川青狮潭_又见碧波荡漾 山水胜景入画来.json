      }
    },
    {
      "id": 4,
      "start": 15.349,
      "end": 18.477,
      "label": "mandarin",
      "text": "给大家带来不一样的游玩体验。",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0008,
        "acoustic_dev": 0.0,
