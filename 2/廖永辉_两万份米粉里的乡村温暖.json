        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "粉丝们热情的留言不断。"
      }
    },
    {
      "id": 12,
      "start": 56.62,
      "end": 62.114,
      "label": "uncertain",
      "text": "他不时回应几句，分享着煮粉的细节和村里头的故事。",
