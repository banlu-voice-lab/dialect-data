        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "最初，廖永飞的直播间只有几十个人观看。"
      }
    },
    {
      "id": 21,
      "start": 95.235,
      "end": 100.432,
      "label": "mandarin",
      "text": "如今粉丝量近两万，高峰时观看人数达到数千人。",
