        "acoustic_dev": 0.444,
        "seg_cer": 0.136,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "备菜的时候，老鹰们经常在旁边帮忙，做豆腐酿、打虾粥。"
      }
    },
    {
      "id": 14,
      "start": 67.582,
      "end": 70.022,
      "label": "mandarin",
      "text": "大家围到一起其乐融融。",
      "score": 0.16,
