        "seg_cer": 0.208,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "来这里吃米粉，吃一大盘。店里面吃的米粉都没有这个好吃。"
      }
