        "seg_cer": 0.152,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "风景优范。下面我们再来听一下蔡湾镇基层生态护林员秦云柏几十年来守护生态保护区十二万亩森林的版录。"
      }
    },
    {
