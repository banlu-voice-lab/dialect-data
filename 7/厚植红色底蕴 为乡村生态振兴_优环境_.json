        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今年五十九岁的秦云波是泉州县菜碗镇基层的一名生态护林员。"
      }
    },
    {
      "id": 4,
      "start": 21.468,
