      }
    },
    {
      "id": 3,
      "start": 9.576,
      "end": 11.867,
      "label": "mandarin",
      "text": "处处洋溢着丰收的喜悦。",
      "score": 0.0,
      "signals": {
        "mand_logprob": -0.0002,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "处处洋溢着丰收的喜悦。",
        "dur": 2.291,
        "n_char": 10
      }
    },
    {
      "id": 4,
      "start": 12.099,
      "end": 19.767,
      "label": "mandarin",
      "text": "经过二十多年的发展，新安县盖首镇新田村委的办公楼前已经自发地形成了一个西瓜销售市场。",
      "score": 0.1797,
      "signals": {
        "mand_logprob": -0.1062,
        "acoustic_dev": 0.115,
        "seg_cer": 0.125,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "新/兴",
        "text_free": "经过二十多年的发展，兴安县街首镇新天村美丽的办公楼前，已经自发地形成了一个西瓜销售市场。",
        "dur": 7.668,
        "n_char": 40
      }
    },
    {
      "id": 5,
      "start": 20.082,
      "end": 25.473,
      "label": "guilin",
      "text": "新了周边县区的瓜农们带着自己屋的种植的西瓜前来售卖。",
      "score": 0.7165,
      "signals": {
        "mand_logprob": -0.6231,
        "acoustic_dev": 1.0,
        "seg_cer": 0.16,
        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "新/兴",
        "lexicon": "屋里",
        "text_free": "兴了，周边小区的瓜农们带着自己屋里又种植的西瓜前来售卖。",
        "dur": 5.391,
        "n_char": 25,
        "text_check": "建议校对"
      }
    },
    {
      "id": 6,
      "start": 25.473,
      "end": 28.702,
      "label": "mandarin",
      "text": "雨水好，天气好，西瓜的话丰收的比较好。",
