        "acoustic_dev": 0.156,
        "seg_cer": 0.054,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "品质是很好的天王嘛。为保证市场秩序，盖守镇政府协同县城管、交警等部门，主动靠前服务。",
        "dur": 7.737,
        "n_char": 37,
        "text_check": "留意"
