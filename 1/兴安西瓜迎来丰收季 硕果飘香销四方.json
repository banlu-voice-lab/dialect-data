        "mand_logprob": -0.0011,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "雨水好，天气好，西瓜的话，丰收的比较好。",
        "dur": 3.229,
        "n_char": 16
      }
    },
    {
      "id": 7,
      "start": 28.702,
      "end": 31.111,
      "label": "mandarin",
      "text": "卖的非常好，我的家的西瓜卖完了，",
      "score": 0.0631,
      "signals": {
        "mand_logprob": -0.0772,
        "acoustic_dev": 0.059,
        "seg_cer": 0.071,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "卖得非常好。我的家的西瓜卖完了。",
        "dur": 2.409,
        "n_char": 14
      }
    },
    {
      "id": 8,
      "start": 31.141,
      "end": 33.586,
