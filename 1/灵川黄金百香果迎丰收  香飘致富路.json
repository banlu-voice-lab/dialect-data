        "acoustic_dev": 0.0,
        "seg_cer": 0.179,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "现在啊，恰好是白香果成熟的季节，在临川县各处的白香果种植基地里面。",
        "dur": 6.068,
        "n_char": 28
      }
    },
    {
      "id": 2,
      "start": 6.535,
      "end": 9.759,
      "label": "mandarin",
      "text": "种植户们忙到采摘成熟的果子，",
