        "dur": 3.224,
        "n_char": 13
      }
    },
    {
      "id": 3,
      "start": 9.759,
      "end": 14.235,
      "label": "mandarin",
      "text": "田间地头呈现出了一派繁忙的丰收景象。",
      "score": 0.0,
      "signals": {
        "mand_logprob": -0.0008,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
