        "seg_cer": 0.111,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "浓浓的香味扑鼻而来，藤蔓下，一颗颗饱满椭圆的白香果点缀其间。",
        "dur": 6.907,
        "n_char": 27
