        "dur": 4.476,
        "n_char": 17
      }
    },
    {
      "id": 4,
      "start": 14.454,
      "end": 18.745,
      "label": "mandarin",
      "text": "走进临川县九屋镇池塘村委蒋家村的种植基地，",
