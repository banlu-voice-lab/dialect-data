      "signals": {
        "mand_logprob": -1.1223,
        "acoustic_dev": 1.0,
        "seg_cer": 0.28,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "lexicon": "咧",
        "text_free": "从小的时候啊，呃，自己想做点些么东西啊，就拿起个就就开始做咧。",
        "dur": 4.696,
        "n_char": 25,
        "text_check": "建议校对"
      }
    },
    {
      "id": 24,
      "start": 101.674,
      "end": 109.542,
      "label": "uncertain",
      "text": "是对这些东西比较感兴趣啊。锤到几根发亮、朝夕卷而来，传统手工打铁生意日渐萧条。",
      "score": 0.4939,
      "signals": {
        "mand_logprob": -0.7795,
        "acoustic_dev": 0.674,
        "seg_cer": 0.314,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "是对几个东西比较感兴趣。吹到秸秆发浪潮席卷而来，传统手工打铁生意一箭萧条。",
        "dur": 7.868,
        "n_char": 35,
        "text_check": "建议校对"
      }
    },
    {
      "id": 25,
      "start": 109.884,
      "end": 112.477,
      "label": "mandarin",
      "text": "曾经热闹的铁匠铺接连关张，",
      "score": 0.0762,
      "signals": {
        "mand_logprob": -0.0083,
        "acoustic_dev": 0.0,
        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "曾经热闹的铁匠铺，寂寥关张。",
        "dur": 2.593,
        "n_char": 12
      }
    },
    {
