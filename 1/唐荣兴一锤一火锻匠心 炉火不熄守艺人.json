        "n_char": 12,
        "text_check": "留意"
      }
    },
    {
      "id": 23,
      "start": 96.656,
      "end": 101.352,
      "label": "guilin",
      "text": "从小的时候，呃，自己想锤点什么东西啊，就拿起锤就开始锤了，",
