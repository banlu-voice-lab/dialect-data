        "acoustic_dev": 0.0,
        "seg_cer": 0.091,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "守着炉火与铁锤，不曾离开。",
        "dur": 3.353,
        "n_char": 11
