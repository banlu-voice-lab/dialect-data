      "signals": {
        "mand_logprob": -0.2364,
        "acoustic_dev": 0.403,
        "seg_cer": 0.222,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "车售房套供应市场，线上线下是一片忙碌啊。",
        "dur": 5.424,
        "n_char": 18,
        "text_check": "留意"
      }
    },
    {
      "id": 3,
      "start": 11.861,
      "end": 17.366,
      "label": "mandarin",
      "text": "在黄桃果园内，绿叶掩映间，一个个饱满的黄桃缀满枝头，",
      "score": 0.0795,
      "signals": {
        "mand_logprob": -0.0022,
        "acoustic_dev": 0.0,
        "seg_cer": 0.174,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "在防涛果园内，绿叶掩映间，一个个饱满的防涛缀满枝头。",
        "dur": 5.505,
        "n_char": 23
      }
    },
    {
      "id": 4,
      "start": 17.564,
      "end": 24.465,
      "label": "mandarin",
      "text": "阵阵桃香扑鼻而来。果农们穿梭在桃树间，忙到摘果、运果、分拣、装箱，",
