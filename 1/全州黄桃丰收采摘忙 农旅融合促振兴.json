  "segments": [
    {
      "id": 1,
      "start": 0.812,
      "end": 5.684,
      "label": "mandarin",
      "text": "眼下还是黄桃成熟的季节，泉州县果农抢抓晴好天气，",
      "score": 0.1313,
      "signals": {
        "mand_logprob": -0.0322,
        "acoustic_dev": 0.013,
        "seg_cer": 0.273,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "眼下还是防套成熟的季节，泉州现过浓强抓晴好天气。",
        "dur": 4.872,
        "n_char": 22
      }
    },
    {
      "id": 2,
      "start": 5.83,
      "end": 11.254,
      "label": "mandarin",
      "text": "采收黄桃，供应市场。线上线下是一片忙碌啊！",
