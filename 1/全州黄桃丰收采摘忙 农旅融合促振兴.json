        "acoustic_dev": 0.0,
        "seg_cer": 0.444,
        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "树/塑 梭/说 农/龙",
        "text_free": "阵阵陶香扑鼻而来。古龙们传说在陶塑间，梦到走过、运过、分解、装箱。",
        "dur": 6.901,
        "n_char": 27
      }
    },
    {
      "id": 5,
      "start": 24.73,
      "end": 27.894,
      "label": "mandarin",
      "text": "现场呈现出一幅繁忙丰收的景象。",
