    },
    {
      "id": 2,
      "start": 9.232,
      "end": 12.903,
      "label": "mandarin",
      "text": "不断的吸引大批中外游客前来打卡。",
      "score": 0.0305,
      "signals": {
        "mand_logprob": -0.0006,
        "acoustic_dev": 0.0,
        "seg_cer": 0.067,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "不断吸引大批中外游客前来打卡。",
        "dur": 3.671,
        "n_char": 15
      }
    },
    {
      "id": 3,
      "start": 13.157,
      "end": 17.906,
      "label": "mandarin",
      "text": "从景观台俯瞰，梯田如碧色天梯，一山而起，",
      "score": 0.0,
      "signals": {
        "mand_logprob": -0.0227,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "从景观台俯瞰，梯田如碧色天梯，一山而起。",
