        "seg_cer": 0.167,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "犹如银泽般尖锐，表皮泛着淡淡的红晕，散发着幽莹的甜香。",
        "dur": 6.513,
        "n_char": 24
