        "mand_logprob": -0.0122,
        "acoustic_dev": 0.001,
        "seg_cer": 0.222,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "一排排隶书整齐排列。",
        "dur": 2.542,
        "n_char": 9
      }
    },
    {
      "id": 3,
      "start": 13.283,
      "end": 18.16,
      "label": "mandarin",
      "text": "一个个果实挂满枝头。果农们穿梭在梨园里面，",
      "score": 0.1481,
      "signals": {
        "mand_logprob": -0.0117,
        "acoustic_dev": 0.0,
        "seg_cer": 0.105,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "梭/说",
        "text_free": "一个个果实挂满枝头，果农们传说在梨园里面。",
        "dur": 4.877,
        "n_char": 19
      }
    },
    {
      "id": 4,
      "start": 18.16,
      "end": 21.02,
      "label": "mandarin",
      "text": "脸上是洋溢着丰收的喜悦。",
      "score": 0.0,
      "signals": {
        "mand_logprob": -0.0002,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "脸上是洋溢着丰收的喜悦。",
        "dur": 2.86,
        "n_char": 11
      }
    },
    {
      "id": 5,
      "start": 21.443,
      "end": 25.109,
      "label": "mandarin",
      "text": "示范基地里的梨园占地面积达到一百亩，",
