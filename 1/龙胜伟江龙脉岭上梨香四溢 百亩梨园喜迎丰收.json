        "mand_logprob": -0.3038,
        "acoustic_dev": 0.537,
        "seg_cer": 0.225,
        "lang_free": "Chinese",
        "phon_confuse": 0.111,
        "phon_examples": "寨/在",
        "text_free": "这段时间，龙胜各族自治县委将乡心在城龙摩岭新品种水果扶贫示范基地里面，是一片繁忙景象。",
        "dur": 10.081,
        "n_char": 40,
        "text_check": "建议校对"
      }
    },
    {
      "id": 2,
      "start": 10.741,
      "end": 13.283,
      "label": "mandarin",
      "text": "一排排梨树整齐排列，",
      "score": 0.1019,
