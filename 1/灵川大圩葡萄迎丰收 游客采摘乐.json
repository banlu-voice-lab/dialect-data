        "seg_cer": 0.129,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "这一段时间，临川县大圩镇青安村委上渡里村的两百多亩葡萄迎来了丰收。",
        "dur": 6.56,
