        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "走进果园，一串串阳光玫瑰垂挂在藤蔓间，翠绿的果色与叶片相映，透着满满的生机。",
