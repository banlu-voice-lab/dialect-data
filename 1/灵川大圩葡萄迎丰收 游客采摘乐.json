        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "吸引了不少游客前来采摘。",
        "dur": 2.802,
        "n_char": 11
      }
    },
    {
      "id": 4,
      "start": 13.765,
      "end": 21.426,
      "label": "mandarin",
      "text": "走进果园，一串串阳光玫瑰垂挂在藤蔓间，翠绿的果色与叶片相映，透着满满的生机。",
