        "acoustic_dev": 0.0,
        "seg_cer": 0.171,
        "lang_free": "Chinese",
        "phon_confuse": 0.167,
        "phon_examples": "声/身",
        "text_free": "翻身效益不断。我是朋友介绍过来的，因为我们家嗯朋友家就在这附近哈。然后说这边葡萄品种也很多。",
        "dur": 7.908,
        "n_char": 41
