    },
    {
      "id": 9,
      "start": 37.959,
      "end": 43.093,
      "label": "mandarin",
      "text": "不少游客慕名前来，大家手提过来，一边欣赏着园内的美景，",
      "score": 0.0381,
      "signals": {
        "mand_logprob": -0.002,
