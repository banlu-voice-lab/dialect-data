        "seg_cer": 0.083,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "不少游客慕名前来，大家手提锅篮，一边欣赏着园内的美景。",
        "dur": 5.134,
        "n_char": 24
      }
    },
    {
      "id": 10,
      "start": 43.208,
      "end": 47.705,
      "label": "mandarin",
      "text": "一边捡下一串串葡萄，感受田园采摘乐趣，",
