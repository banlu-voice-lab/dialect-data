        "acoustic_dev": 0.462,
        "seg_cer": 0.261,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "风一吹，鼓船轻轻晃动，仿佛每影之间在藤蔓间灵动轻舞。",
