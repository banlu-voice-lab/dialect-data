        "lang_free": "Chinese",
        "phon_confuse": 0.25,
        "phon_examples": "山/三",
        "text_free": "从这一年开始，他们每年出价都费跨越三川。",
        "dur": 4.479,
        "n_char": 18
      }
    },
    {
      "id": 4,
      "start": 16.33,
      "end": 19.343,
      "label": "mandarin",
      "text": "来到临川县山区乡镇支教，",
