        "text_free": "来到临川县三区乡镇支教。",
        "dur": 3.013,
        "n_char": 11
      }
    },
    {
      "id": 5,
      "start": 19.5,
      "end": 24.438,
      "label": "mandarin",
      "text": "用热情和青春书写对临川这片土地的温情约定。",
      "score": 0.0,
      "signals": {
        "mand_logprob": -0.0029,
