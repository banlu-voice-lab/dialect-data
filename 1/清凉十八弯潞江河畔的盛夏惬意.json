      "signals": {
        "mand_logprob": -0.5404,
        "acoustic_dev": 0.304,
        "seg_cer": 0.7,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "text_free": "沿途，鼻滩、浅滩，行路起步。",
        "dur": 2.679,
        "n_char": 10,
        "text_check": "建议校对"
      }
    },
    {
      "id": 8,
      "start": 38.684,
      "end": 43.909,
      "label": "mandarin",
