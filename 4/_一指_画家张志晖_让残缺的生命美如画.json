        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "至今，稀发已经有二十二个年头。"
      }
    },
    {
      "id": 10,
      "start": 37.461,
      "end": 40.897,
      "label": "uncertain",
      "text": "五岁那年的一场意外导致左手截肢，",
      "score": 0.4603,
