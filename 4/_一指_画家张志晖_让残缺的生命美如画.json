        "seg_cer": 0.304,
        "lang_free": "Chinese",
        "phon_confuse": 0.143,
        "phon_examples": "灵/临",
        "lexicon": "",
        "text_free": "这个喊做“长治肥”的一只画家，是临川县公平乡安山村人。"
      }
    },
    {
      "id": 9,
      "start": 33.918,
      "end": 37.141,
      "label": "mandarin",
      "text": "至今习画已经有二十二个年头。",
