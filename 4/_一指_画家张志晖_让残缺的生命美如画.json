        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "但是在我们桂林灵川县，有一位特殊的画家。"
      }
    },
    {
      "id": 5,
      "start": 16.801,
      "end": 20.756,
      "label": "mandarin",
      "text": "他啷子个特殊法嘞？他只有一根手指嘛，",
      "score": 0.1257,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0727,
        "acoustic_dev": 0.0,
        "seg_cer": 0.188,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "它啷是个特殊法嘞？它只有一根手指嘛。"
      }
    },
    {
      "id": 6,
      "start": 20.899,
      "end": 24.597,
      "label": "mandarin",
      "text": "能够做到画龙点睛、妙笔生花，妙嘞！",
      "score": 0.1053,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0806,
        "acoustic_dev": 0.0,
        "seg_cer": 0.143,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "嘞",
        "text_free": "能够做到发龙点睛、妙笔生花，妙练。"
      }
    },
    {
      "id": 7,
      "start": 24.597,
      "end": 26.939,
      "label": "uncertain",
      "text": "我们一起来开只眼盖。",
      "score": 0.5051,
      "wav": "",
