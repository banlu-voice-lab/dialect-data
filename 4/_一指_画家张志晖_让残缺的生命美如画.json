      }
    },
    {
      "id": 8,
      "start": 27.52,
      "end": 33.64,
      "label": "uncertain",
      "text": "这个汉族张志飞的一支画家是灵川县公平乡安山村人，",
      "score": 0.4316,
      "wav": "",
      "signals": {
        "mand_logprob": -0.4142,
