        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "城内以山势地形修建的道路，可以讲是四通八达。"
      }
    },
    {
      "id": 8,
      "start": 35.306,
      "end": 41.094,
      "label": "mandarin",
      "text": "可供一车通行。小阳门城位于石城西门外的山脚下，",
      "score": 0.0629,
      "wav": "",
      "signals": {
        "mand_logprob": -0.1776,
        "acoustic_dev": 0.037,
        "seg_cer": 0.095,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "可供引出通行。小阳门城位于石城西门外的山脚下。"
      }
    },
    {
      "id": 9,
      "start": 41.201,
      "end": 46.14,
      "label": "mandarin",
      "text": "穿过村庄往山上走，就是我们要前往的石城西门。",
      "score": 0.0229,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0013,
