    {
      "id": 30,
      "start": 121.559,
      "end": 128.164,
      "label": "mandarin",
      "text": "呃，一个明朝万历年。哦，那我们这个整个石头寨这一片住到几户人家呢？",
      "score": 0.0946,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0934,
        "acoustic_dev": 0.0,
        "seg_cer": 0.207,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "哎，这个年少花年年。哦，那我们这个整个石头寨这一片，住到几户人家呢？"
      }
    },
    {
      "id": 31,
      "start": 128.561,
      "end": 131.338,
      "label": "mandarin",
      "text": "整个石头寨总共也就几户人家，",
