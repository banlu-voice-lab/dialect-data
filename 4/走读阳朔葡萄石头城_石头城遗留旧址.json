        "acoustic_dev": 0.038,
        "seg_cer": 0.3,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "像我们，你赚一万，我们这边赚一万，一千八百几吧。就。"
      }
    },
    {
      "id": 36,
      "start": 143.172,
