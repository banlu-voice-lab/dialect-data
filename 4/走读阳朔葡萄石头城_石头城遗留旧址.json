      }
    },
    {
      "id": 2,
      "start": 3.112,
      "end": 6.51,
      "label": "mandarin",
      "text": "规模宏大，东西南北城门四座，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0021,
        "acoustic_dev": 0.0,
        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "规模宏大，东西南北，城门四座。"
      }
    },
    {
      "id": 3,
      "start": 6.568,
      "end": 11.165,
      "label": "mandarin",
      "text": "将周围的陡峭山峰连成了一个封闭完整、",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.011,
