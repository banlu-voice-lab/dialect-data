        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "将周围的陡峭山峰连成了一个封闭完整。"
      }
    },
    {
      "id": 4,
      "start": 11.165,
      "end": 18.136,
      "label": "mandarin",
      "text": "自成一体的城。城内以山势又构筑了二十四座小门，",
      "score": 0.1435,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0805,
        "acoustic_dev": 0.0,
        "seg_cer": 0.095,
        "lang_free": "Chinese",
        "phon_confuse": 0.5,
        "phon_examples": "山/三",
        "lexicon": "",
        "text_free": "自成一体的城，城内以三市又构筑了二十四座小门。"
      }
    },
    {
      "id": 5,
      "start": 18.383,
      "end": 23.165,
      "label": "mandarin",
      "text": "将石城分割为了若干独城体系的小城。",
      "score": 0.2143,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0027,
