        "seg_cer": 0.5,
        "lang_free": "Cantonese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我哋拉平我哋以后。"
      }
    },
    {
      "id": 22,
      "start": 89.894,
      "end": 94.922,
      "label": "guilin",
      "text": "后来的没人管了，一些搬到一些，那些搬到就还接一个。",
