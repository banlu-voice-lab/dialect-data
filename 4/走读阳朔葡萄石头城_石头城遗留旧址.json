        "acoustic_dev": 0.0,
        "seg_cer": 0.25,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那我就没有统计去啦。大概做了好多人呢。"
