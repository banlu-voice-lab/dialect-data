        "seg_cer": 0.667,
        "lang_free": "Chinese",
        "phon_confuse": 0.111,
        "phon_examples": "山/上",
        "lexicon": "",
        "text_free": "原来是没有大沙箱的，那些到高高那个树上，那看的。"
      }
    },
    {
      "id": 21,
      "start": 87.563,
      "end": 89.894,
      "label": "guilin",
      "text": "跑到拉平过来以后，",
