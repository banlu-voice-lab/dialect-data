        "phon_examples": "城/层 城/层 城/层",
        "lexicon": "",
        "text_free": "将十层分割为了若干独层体系的小层。"
      }
    },
    {
      "id": 6,
      "start": 23.385,
      "end": 29.02,
      "label": "mandarin",
      "text": "小城相互连接，就构成了石城的有机整体。",
      "score": 0.1538,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0003,
        "acoustic_dev": 0.0,
        "seg_cer": 0.118,
        "lang_free": "Chinese",
        "phon_confuse": 1.0,
        "phon_examples": "城/层 城/层",
        "lexicon": "",
        "text_free": "小层相互连接，就构成了石层的有机整体。"
      }
    },
    {
      "id": 7,
      "start": 29.399,
      "end": 35.062,
      "label": "mandarin",
      "text": "城内以山势地形修建的道路，可以讲是四通八达，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0184,
