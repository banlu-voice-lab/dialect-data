    },
    {
      "id": 29,
      "start": 118.053,
      "end": 121.477,
      "label": "mandarin",
      "text": "这个明明朝万历年的时候，",
      "score": 0.3789,
      "wav": "",
      "signals": {
        "mand_logprob": -1.3446,
