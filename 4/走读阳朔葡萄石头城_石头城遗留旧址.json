        "seg_cer": 0.182,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那门也还有，他也这个门都是一直骑到山上去的吧。"
      }
    },
    {
      "id": 20,
      "start": 83.515,
      "end": 87.389,
      "label": "guilin",
      "text": "原来是没有到山上去，先到过那个石山那里，",
