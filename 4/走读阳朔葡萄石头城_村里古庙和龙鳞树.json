        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "古庙一般都是村民们为了祈求平安、保佑大家而设立的。"
      }
    },
    {
      "id": 2,
      "start": 5.658,
      "end": 8.06,
      "label": "mandarin",
      "text": "那这一座古庙喊什么名字呢？",
      "score": 0.0,
