        "seg_cer": 0.353,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "平安无事。廖凯封了银盒文果，边走边回忆。"
      }
    },
    {
      "id": 23,
      "start": 78.237,
      "end": 80.435,
      "label": "mandarin",
      "text": "小时候他不仅在这里读过书，",
