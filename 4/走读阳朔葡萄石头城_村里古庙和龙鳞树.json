        "seg_cer": 0.643,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "嗯，有没有的？这党组的一个，这是第一部分。"
      }
    },
    {
      "id": 20,
      "start": 67.098,
      "end": 69.797,
      "label": "mandarin",
      "text": "哦。第二部分呢，你这个小庙的呢，",
      "score": 0.1573,
      "wav": "",
      "signals": {
        "mand_logprob": -0.3531,
        "acoustic_dev": 0.032,
        "seg_cer": 0.308,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "第二部分呢，以这个巧妙的呢。"
      }
    },
    {
      "id": 21,
      "start": 69.797,
      "end": 73.018,
      "label": "mandarin",
      "text": "你肯定保佑这个村子的人们",
