        "phon_confuse": 0.143,
        "phon_examples": "之/自",
        "lexicon": "",
        "text_free": "故事中的银门，这一种在各自的梦想空间里面见证樱桃园的衰落与变法。"
      }
    },
    {
      "id": 6,
      "start": 43.901,
      "end": 48.077,
      "label": "mandarin",
      "text": "整部剧共分为四场，情节引人入胜，人",
