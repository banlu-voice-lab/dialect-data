        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "我们曾经参观在阳朔定居的一位外国友人。"
      }
    },
    {
      "id": 2,
      "start": 4.095,
      "end": 10.098,
      "label": "mandarin",
      "text": "也就是被当地人称作是“冯子英”的南非人伊恩·汉密尔顿·李班诺。",
      "score": 0.1021,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0636,
