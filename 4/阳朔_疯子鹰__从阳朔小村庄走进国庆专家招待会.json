        "seg_cer": 0.12,
        "lang_free": "Chinese",
        "phon_confuse": 0.333,
        "phon_examples": "民/名",
        "lexicon": "",
        "text_free": "他看到杨朔古名句的时候，就像是发现了被岁月尘封的珍宝。"
      }
    },
    {
      "id": 7,
      "start": 37.857,
      "end": 41.808,
      "label": "mandarin",
      "text": "这些古民居承载着历史的记忆、民族的智慧，",
      "score": 0.0,
