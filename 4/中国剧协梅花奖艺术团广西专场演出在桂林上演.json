        "seg_cer": 0.062,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "中国戏剧家协会美法奖艺术团邀请一九四四年参演第一届西南剧展的广东。"
      }
    },
    {
      "id": 7,
      "start": 39.542,
      "end": 45.914,
