        "seg_cer": 0.062,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今天是国庆长假的最后一天了。我们《半路栏目》带大家一起去阳朔崇州古城。"
      }
    },
    {
      "id": 2,
      "start": 8.146,
      "end": 14.94,
      "label": "mandarin",
      "text": "从桂林出发，沿321国道南行四十公里，就是阳朔县葡萄镇。",
