        "seg_cer": 0.136,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "从桂林出发，沿三二幺国道南行四十公里，就是阳朔县葡萄镇。"
      }
    },
    {
      "id": 3,
      "start": 15.404,
      "end": 19.9,
      "label": "mandarin",
      "text": "葡萄镇杨梅岭村未进来的崇山峻岭间，",
