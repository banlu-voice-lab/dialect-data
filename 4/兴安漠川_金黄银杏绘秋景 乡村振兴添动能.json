        "mand_logprob": -0.3208,
        "acoustic_dev": 0.5,
        "seg_cer": 0.114,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "兴安县木川乡的银杏林，层层枫叶如月而至，新老游人也注进了当地旅游产品的供给。"
      }
    },
    {
      "id": 3,
      "start": 12.846,
      "end": 18.78,
      "label": "uncertain",
      "text": "为乡村振兴添动力。近日，记者走进莫川乡张家七村，",
