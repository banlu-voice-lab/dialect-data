        "seg_cer": 0.143,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "为乡村振兴添动能。今日记者走进磨川乡张家七村。"
      }
    },
    {
      "id": 4,
      "start": 19.005,
      "end": 21.839,
      "label": "mandarin",
      "text": "古老的银杏树遍布乡间，",
