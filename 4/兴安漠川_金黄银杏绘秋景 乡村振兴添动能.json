      "end": 3.434,
      "label": "mandarin",
      "text": "又到一年银杏叶泛黄的季节了，",
      "score": 0.0352,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0056,
        "acoustic_dev": 0.0,
        "seg_cer": 0.077,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "又到一年银杏叶翻黄的季节了。"
      }
    },
    {
      "id": 2,
      "start": 3.434,
      "end": 12.666,
      "label": "mandarin",
      "text": "兴安县莫川乡的银杏林层层黄叶如约而至，新老游人也走进了当地旅游产品的供给，",
