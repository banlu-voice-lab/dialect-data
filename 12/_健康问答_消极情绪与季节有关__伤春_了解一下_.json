        "seg_cer": 0.067,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "短时间的温度、气压都会快速地变化。"
      }
    },
    {
      "id": 12,
