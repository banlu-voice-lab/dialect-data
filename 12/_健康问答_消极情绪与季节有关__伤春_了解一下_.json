        "acoustic_dev": 0.779,
        "seg_cer": 0.308,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "在成绩稍微冷暖交替的时候呢。"
      }
    },
    {
      "id": 11,
      "start": 34.878,
      "end": 38.456,
      "label": "mandarin",
      "text": "短时间的温度、气压都会快速的变化，",
      "score": 0.0305,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0241,
        "sc_logprob": -0.0258,
        "sc_delta": -0.0017,
