        "seg_cer": 0.438,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "工作收入也也不高，生活也是乱乱三三的。"
      }
    },
    {
      "id": 4,
      "start": 8.78,
      "end": 12.248,
      "label": "mandarin",
      "text": "甚至呢可能失眠，而且呢脾气还特别大，",
      "score": 0.0,
      "wav": "",
      "signals": {
        "mand_logprob": -0.0087,
        "sc_logprob": -0.008,
        "sc_delta": 0.0007,
