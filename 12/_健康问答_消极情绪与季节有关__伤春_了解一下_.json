        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "就是你觉得，哎呀，这个情绪好低落。"
      }
    },
    {
      "id": 3,
      "start": 4.796,
      "end": 8.78,
      "label": "mandarin",
      "text": "工作效率也不高，生活也是懒懒散散的，",
      "score": 0.2782,
      "wav": "",
      "signals": {
        "mand_logprob": -0.2033,
