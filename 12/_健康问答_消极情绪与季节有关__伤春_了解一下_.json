        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "今天是春天啦，大家有没有这种感觉啊？"
      }
    },
    {
      "id": 2,
      "start": 2.225,
      "end": 4.796,
      "label": "guilin",
      "text": "就是你觉得，哎，这个情绪好低落，",
      "score": 0.172,
