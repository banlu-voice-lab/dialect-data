        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "意思啊，就是讲，不是世界长出来的东西。"
      }
    },
    {
      "id": 3,
      "start": 7.525,
      "end": 10.805,
      "label": "mandarin",
      "text": "在春天要吃当季、当令、",
