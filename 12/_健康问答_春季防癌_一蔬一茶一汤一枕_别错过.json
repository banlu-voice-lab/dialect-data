        "seg_cer": 0.0,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "为什么这个春季肿瘤的发病率以及复发率就比较高呢？"
      }
    },
    {
      "id": 6,
      "start": 18.909,
      "end": 23.244,
      "label": "mandarin",
      "text": "那么根据中医讲啊，天应相应这个理论，",
      "score": 0.7343,
      "wav": "",
      "signals": {
        "mand_logprob": -1.0582,
        "sc_logprob": -1.0105,
        "sc_delta": 0.0477,
        "acoustic_dev": 1.0,
        "seg_cer": 0.25,
        "lang_free": "Chinese",
        "phon_confuse": 1.0,
        "phon_examples": "应/阴",
        "lexicon": "",
        "text_free": "那么我们根据中医讲啊，天阴相应你这个理论。"
      }
    },
    {
      "id": 7,
      "start": 23.244,
      "end": 30.098,
      "label": "mandarin",
      "text": "那么春季呢是阳气生发，肿瘤细胞呢作为人体突变的细胞，也会突突突突迅速的生长，",
      "score": 0.0392,
