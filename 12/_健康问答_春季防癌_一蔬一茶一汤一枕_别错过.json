      "signals": {
        "mand_logprob": -0.0504,
        "sc_logprob": -0.0505,
        "sc_delta": -0.0001,
        "acoustic_dev": 0.0,
        "seg_cer": 0.086,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "那么，春季呢，是氧气生发肿瘤细胞呢，作为引起突变的细胞，也会突突突突迅速的生长。"
      }
    },
    {
      "id": 8,
