        "seg_cer": 0.053,
        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "要不然，这可能会带来点危险，因为有的蔬菜呢。"
      }
    },
    {
      "id": 11,
      "start": 42.058,
      "end": 44.72,
      "label": "mandarin",
      "text": "天然就携带了危险的分子，",
