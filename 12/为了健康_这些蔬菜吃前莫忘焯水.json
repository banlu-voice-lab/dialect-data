        "lang_free": "Chinese",
        "phon_confuse": 0.0,
        "phon_examples": "",
        "lexicon": "",
        "text_free": "甜言就懈怠了危险的分子。"
      }
    },
    {
      "id": 12,
      "start": 44.864,
      "end": 47.98,
      "label": "mandarin",
      "text": "比方讲，菜豆、红芸豆这些呢，",
      "score": 0.1423,
